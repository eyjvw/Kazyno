---
interface Props
{
	title?: string;
}
const { title = "Kazyno" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <canvas id="ambient-canvas"></canvas>
    <slot />
  </body>
</html>

<script>
	import("../lib/ambient")
		.then(({ initAmbient }) =>
		{
			const c = document.getElementById("ambient-canvas") as HTMLCanvasElement | null;
			if (c) initAmbient(c);
		})
		.catch(() => {});
</script>

<style is:global>
  :root {
    --bg: #0a1612;
    --bg-2: #0e1e18;
    --panel: #142b21;
    --panel-2: #1a352a;
    --raise: #234233;
    --fg: #f2f5ef;
    --muted: #9bb5a4;
    --line: #1f3a2c;
    --accent: #d4af37;
    --accent-hover: #e8c766;
    --accent-ink: #16281d;
    --win: #4ade80;
    --lose: #ef4444;
    --font: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, Helvetica,
      Arial, sans-serif;
    --mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
  }

  #ambient-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    padding: 0;
    min-height: 100%;
  }
  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }
  /* sticky footer: main content grows, footer sits at the bottom */
  body > main {
    flex: 1 0 auto;
    width: 100%;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  /* Animated gradient names (shop cosmetics, name_color = rainbow/fire/ocean/galaxy/toxic) */
  .rainbow-name, .grad-rainbow, .grad-fire, .grad-ocean, .grad-galaxy, .grad-toxic {
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent !important;
    animation: rainbowShift 3s linear infinite;
  }
  .rainbow-name, .grad-rainbow {
    background-image: linear-gradient(90deg, #ef4444, #f59e0b, #22c55e, #06b6d4, #a855f7, #ec4899, #ef4444);
  }
  .grad-fire   { background-image: linear-gradient(90deg, #ef4444, #f97316, #fbbf24, #f97316, #ef4444); }
  .grad-ocean  { background-image: linear-gradient(90deg, #06b6d4, #3b82f6, #22d3ee, #06b6d4); }
  .grad-galaxy { background-image: linear-gradient(90deg, #a855f7, #ec4899, #6366f1, #a855f7); }
  .grad-toxic  { background-image: linear-gradient(90deg, #22c55e, #84cc16, #a3e635, #22c55e); }
  @keyframes rainbowShift {
    from { background-position: 0% 50%; }
    to   { background-position: 300% 50%; }
  }

  ::selection {
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* ── Top nav ────────────────────────────────────────────────────────── */
  .nav {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px clamp(16px, 4vw, 40px);
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
  }
  .nav .brand {
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 18px;
  }
  .nav .brand b {
    color: var(--accent);
  }
  .nav .spacer {
    flex: 1;
  }
  .pill {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 9px 14px;
    font-variant-numeric: tabular-nums;
  }
  .pill b {
    font-size: 15px;
  }
  .pill span {
    color: var(--muted);
    font-size: 12px;
  }
  .ghost-btn {
    background: var(--panel);
    border: 1px solid var(--line);
    color: var(--muted);
    border-radius: 8px;
    padding: 9px 14px;
    font-family: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .ghost-btn:hover {
    color: var(--fg);
    border-color: var(--accent);
  }

  /* ── Generic primitives ─────────────────────────────────────────────── */
  .panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: var(--accent-ink);
    border: none;
    border-radius: 10px;
    font-family: inherit;
    font-weight: 700;
    font-size: 15px;
    padding: 14px 18px;
    cursor: pointer;
    box-shadow: 0 0 0 rgba(212, 175, 55, 0);
    transition: background 0.15s, transform 0.06s, opacity 0.15s, box-shadow 0.2s;
  }
  .btn:hover {
    background: var(--accent-hover);
    box-shadow: 0 4px 20px rgba(212, 175, 55, 0.25);
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 12px;
    color: var(--muted);
  }
  .input {
    background: var(--bg-2);
    border: 1px solid var(--line);
    color: var(--fg);
    border-radius: 8px;
    font-family: inherit;
    font-size: 15px;
    padding: 12px 13px;
    outline: none;
    width: 100%;
    font-variant-numeric: tabular-nums;
    transition: border-color 0.15s;
  }
  .input:focus {
    border-color: var(--accent);
  }
  .seg {
    display: grid;
    grid-auto-flow: column;
    gap: 6px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 4px;
  }
  .seg button {
    background: transparent;
    border: none;
    color: var(--muted);
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    padding: 9px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .seg button.is-active {
    background: var(--raise);
    color: var(--fg);
  }
  .chips {
    display: grid;
    grid-auto-flow: column;
    gap: 6px;
  }
  .chips button {
    background: var(--raise);
    border: none;
    color: var(--fg);
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    padding: 9px;
    border-radius: 6px;
    cursor: pointer;
    transition: filter 0.15s;
  }
  .chips button:hover {
    filter: brightness(1.2);
  }

  /* ── Game shell (bet panel + stage) ─────────────────────────────────── */
  .game-header {
    /* body est un flex column : margin auto désactive le stretch,
       width 100% requis sinon largeur = contenu (grille mines → points) */
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 28px clamp(16px, 4vw, 40px) 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .game-header .gh-icon {
    font-size: 28px;
    line-height: 1;
  }
  .game-header h1 {
    margin: 0;
    font-size: clamp(20px, 3.5vw, 28px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .gh-rules {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--panel);
    border: 1px solid var(--line);
    color: var(--muted);
    border-radius: 20px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 700;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .gh-rules:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .game-header .gh-sub {
    margin: 0 0 0 4px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 400;
  }
  .shell {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(12px, 2vw, 20px) clamp(16px, 4vw, 40px) clamp(16px, 3vw, 32px);
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 16px;
    align-items: stretch;
  }
  .betpanel {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .bet-btn {
    width: 100%;
    padding: 16px;
    font-size: 16px;
  }
  .stage {
    padding: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    min-height: 520px;
    position: relative;
    overflow: hidden;
  }
  .result {
    margin: 0;
    min-height: 20px;
    font-size: 13px;
    text-align: center;
  }
  .result.win {
    color: var(--win);
  }
  .result.lose {
    color: var(--lose);
  }
  .stat-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .stat {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 9px 11px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat span {
    color: var(--muted);
    font-size: 11px;
  }
  .stat b {
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 820px) {
    .shell {
      grid-template-columns: 1fr;
    }
    .stage {
      min-height: 320px;
      order: -1;
    }
  }

  /* ── Toasts ─────────────────────────────────────────────────────────── */
  .toast-host {
    position: fixed;
    right: 16px;
    bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    z-index: 1000;
  }
  .toast {
    background: var(--panel-2);
    border: 1px solid var(--accent);
    border-radius: 10px;
    padding: 12px 16px;
    padding-right: 36px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
    transform: translateX(120%);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
    position: relative;
  }
  .toast.show {
    transform: translateX(0);
    opacity: 1;
  }
  .toast.clickable {
    cursor: pointer;
    display: block;
  }
  .toast.clickable:hover {
    border-color: var(--accent-hover);
  }
  .toast-close {
    position: absolute;
    top: 50%;
    right: 10px;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--muted);
    font-size: 12px;
    cursor: pointer;
    padding: 2px 4px;
    line-height: 1;
    border-radius: 3px;
    transition: color 0.15s;
  }
  .toast-close:hover {
    color: var(--lose);
  }

  /* ── Rain banner ────────────────────────────────────────────────────── */
  .rain-banner {
    position: fixed;
    top: 72px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 14px;
    background: linear-gradient(135deg, rgba(20, 43, 33, 0.95), rgba(14, 30, 24, 0.95));
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 12px 18px;
    z-index: 1100;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55), 0 0 24px rgba(212, 175, 55, 0.3);
    animation: rainDrop 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes rainDrop {
    from { transform: translate(-50%, -30px); opacity: 0; }
    to   { transform: translate(-50%, 0);     opacity: 1; }
  }
  .rain-txt { font-size: 13px; font-weight: 700; }
  .rain-txt b { color: var(--accent); }
  .rain-claim {
    background: var(--accent);
    color: var(--accent-ink);
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.1s, filter 0.15s;
  }
  .rain-claim:hover:not(:disabled) { filter: brightness(1.15); transform: translateY(-1px); }
  .rain-claim:disabled { opacity: 0.6; cursor: wait; }

  /* ── Leaderboard rank-change flash ──────────────────────────────────── */
  @keyframes flashUp {
    0% { box-shadow: 0 0 0 rgba(0, 231, 1, 0); }
    25% { box-shadow: 0 0 22px rgba(0, 231, 1, 0.55); border-color: var(--win); }
    100% { box-shadow: 0 0 0 rgba(0, 231, 1, 0); }
  }
  @keyframes flashDown {
    0% { box-shadow: 0 0 0 rgba(237, 65, 99, 0); }
    25% { box-shadow: 0 0 22px rgba(237, 65, 99, 0.5); border-color: var(--lose); }
    100% { box-shadow: 0 0 0 rgba(237, 65, 99, 0); }
  }

  /* ── Session tracker ────────────────────────────────────────────────── */
  .hist-bar {
    align-self: stretch;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    min-height: 28px;
  }
  .hchip {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 5px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .hw { background: rgba(0, 231, 1, 0.12); color: var(--win); }
  .hl { background: rgba(237, 65, 99, 0.12); color: var(--lose); }
  .hempty { color: var(--muted); font-size: 12px; }
  .sess-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .ss {
    background: var(--bg-2);
    border-radius: 7px;
    padding: 7px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ss span { color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; }
  .ss b { font-size: 12px; font-variant-numeric: tabular-nums; }
  .spos { color: var(--win); }
  .sneg { color: var(--lose); }

  /* ── Shared footer ──────────────────────────────────────────────────── */
  .site-foot {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    max-width: 1100px;
    margin: 0 auto;
    padding: 22px clamp(16px, 4vw, 40px);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  .site-foot a {
    color: var(--muted);
    font-weight: 600;
  }
  .site-foot a:hover {
    color: var(--accent);
  }
  .site-foot .muted {
    opacity: 0.6;
  }

  /* ── 3D table labels (CSS2D) ────────────────────────────────────────── */
  .bj-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-family: var(--font);
    text-align: center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
    user-select: none;
    white-space: nowrap;
  }
  .bj-label .bj-name {
    font-size: 13px;
    font-weight: 700;
    color: #fff;
  }
  .bj-label .bj-name.me {
    color: var(--accent-hover);
  }
  .bj-label .bj-line {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .bj-label .bj-val {
    background: rgba(0, 0, 0, 0.55);
    border-radius: 6px;
    padding: 1px 8px;
    font-size: 13px;
    font-weight: 800;
    color: #fff;
  }
  .bj-label .bj-bet {
    color: #ffd24a;
    font-size: 12px;
    font-weight: 700;
  }
  .bj-label .bj-res {
    font-size: 12px;
    font-weight: 800;
  }
  .bj-label .bj-res.win,
  .bj-label .bj-res.blackjack {
    color: var(--win);
  }
  .bj-label .bj-res.lose,
  .bj-label .bj-res.bust {
    color: var(--lose);
  }
  .bj-label .bj-res.push {
    color: #cfcfcf;
  }
</style>
