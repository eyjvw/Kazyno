---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Kazyno — 42">
  <div class="page">
    <header class="topbar">
      <span class="brand">Kazyno</span>
      <span class="tag" data-i18n="home.tag">42 Le Havre</span>
    </header>

    <section class="hero">
      <div class="hero-inner">
        <div class="hero-text">
          <h1 class="title">Kazyno</h1>
          <p class="lede" data-i18n-lede></p>
          <a class="btn" href="/api/auth/42" data-i18n="home.cta">Se connecter avec 42 →</a>
        </div>
        <div class="hero-showcase" data-showcase>
          <div class="show-tile tile-slots"    style="--rot:-7deg"  data-depth="14"><span class="tile-inner">🎰</span></div>
          <div class="show-tile tile-dice"     style="--rot:5deg"   data-depth="22"><span class="tile-inner">🎲</span></div>
          <div class="show-tile tile-cards"    style="--rot:-4deg"  data-depth="10"><span class="tile-inner">🃏</span></div>
          <div class="show-tile tile-wheel"    style="--rot:8deg"   data-depth="26"><span class="tile-inner">🎡</span></div>
          <div class="show-tile tile-mines"    style="--rot:-9deg"  data-depth="18"><span class="tile-inner">💣</span></div>
          <div class="show-tile tile-crash"    style="--rot:6deg"   data-depth="12"><span class="tile-inner">🚀</span></div>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<script>
	import { t, onLocaleChange, type TKey } from "../lib/i18n";

	function applyI18n()
	{
		document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) =>
		{
			el.textContent = t(el.dataset.i18n as TKey);
		});
	}

	function renderLede()
	{
		const lede = document.querySelector<HTMLElement>("[data-i18n-lede]");
		if (!lede) return;
		const raw = t("home.lede", { points: "___POINTS___" });
		lede.innerHTML = raw.replace("___POINTS___", `<span class="accent">1000 points</span>`);
	}

	applyI18n();
	renderLede();
	onLocaleChange(() => { applyI18n(); renderLede(); });

	// Mouse-parallax on the game-tile mosaic: each tile drifts by its own
	// depth so the mosaic feels 3D, hover zoom handled separately in CSS.
	const showcase = document.querySelector<HTMLElement>("[data-showcase]");
	if (showcase && matchMedia("(hover: hover)").matches)
	{
		const tiles = [...showcase.querySelectorAll<HTMLElement>(".show-tile")];
		showcase.addEventListener("mousemove", (e) =>
		{
			const rect = showcase.getBoundingClientRect();
			const px = (e.clientX - rect.left) / rect.width - 0.5;
			const py = (e.clientY - rect.top) / rect.height - 0.5;
			tiles.forEach((tile) =>
			{
				const depth = Number(tile.dataset.depth ?? 15);
				tile.style.transform = `translate3d(${px * depth}px, ${py * depth}px, 0)`;
			});
		});
		showcase.addEventListener("mouseleave", () =>
		{
			tiles.forEach((tile) => { tile.style.transform = "translate3d(0,0,0)"; });
		});
	}

	// Guard: already logged in -> skip the landing.
	fetch("/api/auth/me")
		.then((r) => (r.ok ? r.json() : null))
		.then((d) =>
		{
			if (d?.authenticated) location.replace("/app");
		})
		.catch(() => {});
</script>

<style>
  .page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  /* ambient glow so the space feels full */
  .page::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 80% 0%, rgba(212, 175, 55, 0.16), transparent 60%),
      radial-gradient(50% 50% at 0% 100%, rgba(74, 222, 128, 0.08), transparent 55%);
    pointer-events: none;
  }

  .topbar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px clamp(20px, 5vw, 56px);
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  .brand {
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 18px;
  }
  .tag {
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .accent {
    color: var(--accent);
  }

  .hero {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px clamp(20px, 5vw, 56px);
  }
  .hero-inner {
    display: flex;
    align-items: center;
    gap: clamp(24px, 5vw, 64px);
  }
  .hero-text { flex: 1; min-width: 0; }
  .title {
    font-size: clamp(48px, 8vw, 108px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0;
    font-weight: 800;
  }

  /* ── Game-tile mosaic showcase ── */
  .hero-showcase {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 420px;
    perspective: 900px;
  }
  .show-tile {
    position: absolute;
    width: 130px;
    height: 100px;
    border-radius: 18px;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.4);
  }
  .tile-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 42px;
    border-radius: 18px;
    transform: rotate(var(--rot));
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s;
  }
  .show-tile:hover { z-index: 5; }
  .show-tile:hover .tile-inner {
    transform: rotate(0deg) scale(1.18);
  }
  .tile-slots { top: 6%;  left: 8%; }
  .tile-dice  { top: 2%;  left: 46%; }
  .tile-cards { top: 30%; left: 68%; }
  .tile-wheel { top: 44%; left: 20%; }
  .tile-mines { top: 62%; left: 52%; }
  .tile-crash { top: 66%; left: 2%; }

  .tile-slots .tile-inner { background: linear-gradient(135deg, rgba(212,175,55,0.28), var(--panel)); border: 1px solid rgba(212,175,55,0.35); }
  .tile-dice  .tile-inner { background: linear-gradient(135deg, rgba(239,68,68,0.22), var(--panel));  border: 1px solid rgba(239,68,68,0.3); }
  .tile-cards .tile-inner { background: linear-gradient(135deg, rgba(74,222,128,0.22), var(--panel));  border: 1px solid rgba(74,222,128,0.3); }
  .tile-wheel .tile-inner { background: linear-gradient(135deg, rgba(212,175,55,0.22), var(--panel));  border: 1px solid rgba(212,175,55,0.3); }
  .tile-mines .tile-inner { background: linear-gradient(135deg, rgba(239,68,68,0.18), var(--panel));   border: 1px solid rgba(239,68,68,0.28); }
  .tile-crash .tile-inner { background: linear-gradient(135deg, rgba(74,222,128,0.18), var(--panel));  border: 1px solid rgba(74,222,128,0.28); }

  @media (max-width: 900px) {
    .hero-inner { flex-direction: column; align-items: stretch; }
    /* Mobile: absolute %-positioned tiles pile onto the title. Flow them
       in a static grid so nothing overlaps the text. */
    .hero-showcase {
      height: auto;
      order: -1;
      perspective: none;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 8px;
    }
    .show-tile {
      position: static;
      width: auto;
      height: 84px;
      transform: none !important;
    }
    .tile-inner { font-size: 34px; }
  }
  .lede {
    max-width: 600px;
    margin: 28px 0 0;
    color: var(--muted);
    font-size: clamp(15px, 2vw, 18px);
  }
  .btn {
    display: inline-block;
    align-self: flex-start;
    margin-top: 40px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 16px;
    padding: 16px 28px;
    border-radius: 10px;
    transition: filter 0.15s, transform 0.08s;
  }
  .btn:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
  }
</style>
