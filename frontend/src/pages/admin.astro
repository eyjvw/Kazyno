---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Kazyno — Admin">
  <Nav />
  <main class="wrap">
    <header class="head">
      <h1>Panel admin 🛠️</h1>
      <p>Joueurs, points, giveaways — et le live log en continu à droite.</p>
    </header>

    <nav class="quicknav" data-quicknav hidden>
      <a href="#a-notif">🔔 Notif</a>
      <a href="#a-points">💰 Points</a>
      <a href="#a-rain">🌧️ Pluie</a>
      <a href="#a-giveaways">🎁 Giveaways</a>
      <a href="#a-logs">📡 Logs</a>
      <a href="#a-danger" class="qn-danger">⚠️ Danger</a>
    </nav>

    <div class="admin-cols">
    <div class="admin-main">

    <div class="grid" data-panel hidden>
      <section class="panel card" id="a-notif">
        <h2>🔔 Envoyer une notification</h2>
        <label class="lbl">Message</label>
        <textarea class="input" data-msg rows="3" maxlength="280" placeholder="Message aux joueurs…"></textarea>

        <label class="lbl">Destinataire — vide = tout le monde</label>
        <div class="picker" data-picker="notif">
          <input class="input" data-search placeholder="Rechercher un joueur…" autocomplete="off" />
          <ul class="presults" data-results hidden></ul>
          <div class="chip" data-chip hidden>
            <img class="cav" data-chip-av width="40" height="40" alt="" hidden />
            <span class="cav fb" data-chip-fb hidden></span>
            <div class="chip-info">
              <span class="chip-name" data-chip-name></span>
              <span class="chip-meta" data-chip-meta></span>
            </div>
            <button type="button" class="chip-clear" data-clear>✕</button>
          </div>
        </div>

        <button class="btn" data-send>Envoyer</button>
        <p class="msg" data-msg-res></p>
      </section>

      <section class="panel card" id="a-points">
        <h2>💰 Ajouter / retirer des points</h2>
        <label class="lbl">Joueur</label>
        <div class="picker" data-picker="points">
          <input class="input" data-search placeholder="Rechercher un joueur…" autocomplete="off" />
          <ul class="presults" data-results hidden></ul>
          <div class="chip" data-chip hidden>
            <img class="cav" data-chip-av width="40" height="40" alt="" hidden />
            <span class="cav fb" data-chip-fb hidden></span>
            <div class="chip-info">
              <span class="chip-name" data-chip-name></span>
              <span class="chip-meta" data-chip-meta></span>
            </div>
            <button type="button" class="chip-clear" data-clear>✕</button>
          </div>
        </div>

        <label class="lbl">Montant (négatif pour retirer)</label>
        <input class="input" data-pts-amount type="number" value="100" />
        <button class="btn" data-grant>Appliquer</button>
        <p class="msg" data-pts-res></p>
      </section>

      <section class="panel card" id="a-rain">
        <h2>🌧️ Faire pleuvoir des points</h2>
        <label class="lbl">Montant total</label>
        <input class="input" data-rain-amount type="number" value="1000" min="10" />
        <label class="lbl">Nombre de gagnants</label>
        <input class="input" data-rain-winners type="number" value="5" min="1" max="100" />
        <button class="btn" data-rain-start>Lancer la pluie 🌧️</button>
        <p class="msg" data-rain-res></p>
      </section>

      <section class="panel card danger-card" id="a-danger" data-danger-section>
        <h2>⚠️ Zone dangereuse</h2>
        <p class="danger-desc">Remet tous les joueurs à 1 000 pts. Irréversible.</p>
        <button class="btn btn-danger" data-reset-all>Reset tout le monde → 1 000 pts</button>
        <p class="msg" data-reset-res></p>
      </section>

    </div>

    <section class="panel card exam-card" id="a-giveaways" data-giveaway-section hidden>
      <div class="exam-header">
        <h2>🎁 Giveaways</h2>
        <span class="exam-help">Un gagnant est tiré au hasard automatiquement à la date de fin.</span>
      </div>

      <div class="exam-form">
        <input class="input exam-input" data-gw-title placeholder="Titre (ex: Giveaway Noël)" maxlength="80" />
        <input class="input exam-input" data-gw-prize type="number" min="1" placeholder="Points" />
        <input class="input exam-input exam-date" data-gw-date type="date" />
        <input class="input exam-input exam-time" data-gw-time type="time" value="20:00" />
        <button class="btn exam-add-btn" data-gw-add>Créer</button>
      </div>
      <input class="input" data-gw-desc placeholder="Description (optionnel)" maxlength="280" style="margin-top:8px" />
      <p class="msg" data-gw-res></p>

      <ul class="exam-list" data-gw-list>
        <li class="exam-empty">Chargement…</li>
      </ul>
    </section>

    </div><!-- /admin-main -->

    <aside class="admin-side">
    <section class="panel log-panel" id="a-logs" data-log-panel hidden>
      <div class="log-head">
        <span class="log-title">Live log</span>
        <span class="log-dot" data-log-dot></span>
        <button class="log-clear" data-log-clear>Vider</button>
      </div>

      <div class="log-filters">
        <div class="flt-row">
          <div class="flt-picker">
            <input class="input flt-input" data-f-login placeholder="Rechercher un login…" autocomplete="off" />
            <button class="flt-clear-login" data-f-login-clear hidden>✕</button>
            <ul class="flt-presults" data-f-results hidden></ul>
          </div>
          <select class="input flt-select" data-f-action>
            <option value="">Toutes actions</option>
            <option value="bet">Mises</option>
            <option value="points">Points admin</option>
            <option value="rain">Pluies</option>
            <option value="gift">Cadeaux</option>
            <option value="duel">Duels</option>
            <option value="treasure">Chasse au trésor</option>
            <option value="reset-all">Reset général</option>
          </select>
        </div>
        <div class="flt-row">
          <span class="flt-range-label">Du</span>
          <input class="input flt-input flt-date" type="date" data-f-from />
          <span class="flt-range-label">au</span>
          <input class="input flt-input flt-date" type="date" data-f-to />
          <button class="flt-reset" data-f-reset hidden title="Effacer les filtres">✕ Filtres</button>
        </div>
      </div>

      <p class="log-count" data-log-count hidden></p>
      <ul class="log-list" data-log-list></ul>
      <div class="log-pagination" data-log-pagination hidden>
        <button class="ghost-btn" data-page-prev>← Préc.</button>
        <span data-page-info></span>
        <button class="ghost-btn" data-page-next>Suiv. →</button>
      </div>
    </section>
    </aside><!-- /admin-side -->
    </div><!-- /admin-cols -->

    <p class="denied" data-denied hidden>Accès réservé aux admins.</p>
  </main>
  <Footer />
</Layout>

<script>
	import {
		loadMe,
		adminMe,
		adminSearch,
		adminNotify,
		adminAddPoints,
		adminResetAll,
		adminStartRain,
		adminGetLogs,
		getGiveaways,
		adminCreateGiveaway,
		adminDeleteGiveaway,
		connectRealtime,
		onAdminLog,
		fmt,
	} from "../lib/casino";

	const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;

	// ── Rain ────────────────────────────────────────────────────────────────
	$("[data-rain-start]").addEventListener("click", async () =>
	{
		const amount = Math.floor(Number($<HTMLInputElement>("[data-rain-amount]").value));
		const winners = Math.floor(Number($<HTMLInputElement>("[data-rain-winners]").value));
		const res = $("[data-rain-res]");
		try
		{
			await adminStartRain(amount, winners);
			res.textContent = `🌧️ Pluie lancée : ${fmt(Math.floor(amount / winners))} pts × ${winners} gagnants (60s)`;
		}
		catch (e: any)
		{
			res.textContent = e?.message ?? "Erreur";
		}
	});

	function makePicker(root: HTMLElement)
	{
		const input = root.querySelector<HTMLInputElement>("[data-search]")!;
		const results = root.querySelector<HTMLElement>("[data-results]")!;
		const chip = root.querySelector<HTMLElement>("[data-chip]")!;
		const chipName = root.querySelector<HTMLElement>("[data-chip-name]")!;
		const chipMeta = root.querySelector<HTMLElement>("[data-chip-meta]")!;
		const chipAv = root.querySelector<HTMLImageElement>("[data-chip-av]")!;
		const chipFb = root.querySelector<HTMLElement>("[data-chip-fb]")!;
		let selected: string | null = null;
		let timer: number;

		input.addEventListener("input", () =>
		{
			clearTimeout(timer);
			const q = input.value.trim();
			if (!q)
			{
				results.hidden = true;
				results.innerHTML = "";
				return;
			}
			timer = window.setTimeout(async () =>
			{
				const list = await adminSearch(q);
				results.innerHTML = list.length
					? list
							.map((u: any) =>
							{
								const name = u.display_name || u.login;
								const av = u.image_url
									? `<img class="pav" src="${u.image_url}" width="32" height="32" alt="" />`
									: `<span class="pav fb">${u.login.charAt(0).toUpperCase()}</span>`;
								return `<li data-login="${u.login}" data-name="${name}" data-image="${u.image_url || ""}" data-pts="${u.points}">
										${av}
										<span class="pinfo"><b>@${u.login}</b><small>${Number(u.points).toLocaleString()} pts</small></span>
									</li>`;
							})
							.join("")
					: `<li class="empty">aucun résultat</li>`;
				results.hidden = false;
			}, 200);
		});

		results.addEventListener("click", (e) =>
		{
			const li = (e.target as HTMLElement).closest<HTMLElement>("li[data-login]");
			if (!li) return;
			selected = li.dataset.login!;
			chipName.textContent = `@${li.dataset.login}`;
			chipMeta.textContent = `${Number(li.dataset.pts).toLocaleString()} pts`;
			const img = li.dataset.image;
			if (img)
			{
				chipAv.src = img;
				chipAv.hidden = false;
				chipFb.hidden = true;
			}
			else
			{
				chipFb.textContent = li.dataset.name!.charAt(0).toUpperCase();
				chipFb.hidden = false;
				chipAv.hidden = true;
			}
			chip.hidden = false;
			input.value = "";
			input.hidden = true;
			results.hidden = true;
		});
		root.querySelector("[data-clear]")!.addEventListener("click", () =>
		{
			selected = null;
			chip.hidden = true;
			input.hidden = false;
			input.focus();
		});

		return { get login() { return selected; } };
	}

	loadMe().then(async (me) =>
	{
		if (!me) return;
		if (!(await adminMe()))
		{
			$("[data-denied]").hidden = false;
			return;
		}
		$("[data-panel]").hidden = false;
		$("[data-quicknav]").hidden = false;
		$("[data-danger-section]").hidden = false;

		// ── Giveaway management ─────────────────────────────────────────────────
		$("[data-giveaway-section]").hidden = false;
		const gwList = $("[data-gw-list]");
		const gwRes  = $("[data-gw-res]");

		function renderGiveaways(active: any[])
		{
			if (!active.length)
			{
				gwList.innerHTML = `<li class="exam-empty">Aucun giveaway en cours.</li>`;
				return;
			}
			gwList.innerHTML = active.map((g: any) =>
			{
				const date = new Date(g.ends_at).toLocaleString("fr-FR", { dateStyle: "medium", timeStyle: "short" });
				return `<li class="exam-row" data-gid="${g.id}">
					<div class="exam-info">
						<span class="exam-label">${g.title}</span>
						<span class="exam-meta">${date} · ${fmt(g.prize_points)} pts · ${g.entry_count} participant${g.entry_count !== 1 ? "s" : ""}</span>
					</div>
					<div class="exam-actions">
						<button class="ghost-btn exam-del-btn" data-gw-del="${g.id}">Suppr.</button>
					</div>
				</li>`;
			}).join("");

			gwList.querySelectorAll<HTMLButtonElement>("[data-gw-del]").forEach((btn) =>
			{
				btn.addEventListener("click", async () =>
				{
					if (!confirm("Supprimer ce giveaway ?")) return;
					try
					{
						await adminDeleteGiveaway(Number(btn.dataset.gwDel));
						await refreshGiveaways();
					} catch (e: any) { alert(e?.message ?? "Erreur"); }
				});
			});
		}

		async function refreshGiveaways()
		{
			const { active } = await getGiveaways();
			renderGiveaways(active);
		}
		await refreshGiveaways();

		$("[data-gw-add]").addEventListener("click", async () =>
		{
			gwRes.textContent = "";
			gwRes.className = "msg";
			const title   = $<HTMLInputElement>("[data-gw-title]").value.trim();
			const desc    = $<HTMLInputElement>("[data-gw-desc]").value.trim();
			const prize   = Math.floor(Number($<HTMLInputElement>("[data-gw-prize]").value));
			const dateVal = $<HTMLInputElement>("[data-gw-date]").value;
			const timeVal = $<HTMLInputElement>("[data-gw-time]").value || "20:00";
			if (!title)        { gwRes.textContent = "Titre requis";  gwRes.className = "msg err"; return; }
			if (!prize)        { gwRes.textContent = "Points requis"; gwRes.className = "msg err"; return; }
			if (!dateVal)      { gwRes.textContent = "Date requise";  gwRes.className = "msg err"; return; }
			try
			{
				await adminCreateGiveaway(title, desc, prize, new Date(`${dateVal}T${timeVal}`).toISOString());
				gwRes.textContent = "Giveaway créé ✓";
				gwRes.className = "msg ok";
				$<HTMLInputElement>("[data-gw-title]").value = "";
				$<HTMLInputElement>("[data-gw-desc]").value = "";
				$<HTMLInputElement>("[data-gw-prize]").value = "";
				$<HTMLInputElement>("[data-gw-date]").value = "";
				$<HTMLInputElement>("[data-gw-time]").value = "20:00";
				await refreshGiveaways();
			}
			catch (e: any)
			{
				gwRes.textContent = e?.message ?? "Erreur";
				gwRes.className = "msg err";
			}
		});

		const notifPicker = makePicker($('[data-picker="notif"]'));
		const ptsPicker = makePicker($('[data-picker="points"]'));

		$("[data-send]").addEventListener("click", async () =>
		{
			const res = $("[data-msg-res]");
			res.textContent = "";
			res.className = "msg";
			try
			{
				await adminNotify($<HTMLTextAreaElement>("[data-msg]").value, notifPicker.login ?? undefined);
				res.textContent = notifPicker.login
					? "Notification envoyée au joueur ✓"
					: "Notification envoyée à tout le monde ✓";
				res.classList.add("ok");
				$<HTMLTextAreaElement>("[data-msg]").value = "";
			}
			catch (e: any)
			{
				res.textContent = e?.message ?? "Erreur";
				res.classList.add("err");
			}
		});

		$("[data-grant]").addEventListener("click", async () =>
		{
			const res = $("[data-pts-res]");
			res.textContent = "";
			res.className = "msg";
			if (!ptsPicker.login)
			{
				res.textContent = "Choisis un joueur";
				res.classList.add("err");
				return;
			}
			try
			{
				const r = await adminAddPoints(
					ptsPicker.login,
					Number($<HTMLInputElement>("[data-pts-amount]").value),
				);
				res.textContent = `OK — nouveau solde : ${r.points.toLocaleString()} pts`;
				res.classList.add("ok");
			}
			catch (e: any)
			{
				res.textContent = e?.message ?? "Erreur";
				res.classList.add("err");
			}
		});

		$("[data-reset-all]").addEventListener("click", async () =>
		{
			const res = $("[data-reset-res]");
			res.textContent = "";
			res.className = "msg";
			if (!confirm("Reset TOUS les joueurs à 1 000 pts ? Irréversible.")) return;
			try
			{
				await adminResetAll();
				res.textContent = "Reset effectué ✓";
				res.classList.add("ok");
			}
			catch (e: any)
			{
				res.textContent = e?.message ?? "Erreur";
				res.classList.add("err");
			}
		});

		// ── Live log ──────────────────────────────────────────────────────────
		const logPanel     = $("[data-log-panel]");
		const logList      = $("[data-log-list]");
		const logDot       = $("[data-log-dot]");
		const logCount     = $("[data-log-count]");
		const logPagination= $("[data-log-pagination]");
		const fLoginInput  = $<HTMLInputElement>("[data-f-login]");
		const fLoginClear  = $<HTMLButtonElement>("[data-f-login-clear]");
		const fResults     = $("[data-f-results]");
		logPanel.hidden    = false;

		const LIMIT = 50;
		let currentPage = 0;
		let activeLogin = ""; // resolved login from picker

		const GAME_ICON: Record<string, string> = {
			coinflip: "🪙", dice: "🎲", limbo: "🚀", plinko: "🔻", slots: "🎰", blackjack: "🃏",
		};

		function getFilters()
		{
			return {
				login:  activeLogin || undefined,
				action: $<HTMLSelectElement>("[data-f-action]").value || undefined,
				from:   $<HTMLInputElement>("[data-f-from]").value   || undefined,
				to:     $<HTMLInputElement>("[data-f-to]").value     || undefined,
			};
		}

		function eventMatchesFilters(event: any): boolean
		{
			const f = getFilters();
			if (f.login)
			{
				const l = f.login.toLowerCase();
				const el = ((event.login ?? "") + (event.target ?? "")).toLowerCase();
				if (!el.includes(l)) return false;
			}
			if (f.action && event.action !== f.action) return false;
			if (f.from || f.to)
			{
				const d = new Date(typeof event.ts === "number" ? event.ts : event.ts)
					.toISOString().slice(0, 10);
				if (f.from && d < f.from) return false;
				if (f.to   && d > f.to)   return false;
			}
			return true;
		}

		function renderEntry(event: any): HTMLLIElement
		{
			const date = new Date(typeof event.ts === "number" ? event.ts : event.ts);
			const ts   = date.toLocaleString("fr-FR", { dateStyle: "short", timeStyle: "medium" });
			let text = "";
			if (event.action === "bet")
			{
				const icon = GAME_ICON[event.game] ?? "🎮";
				const net  = (event.payout ?? 0) - event.bet;
				const diff = net >= 0 ? `+${net.toLocaleString()}` : `${net.toLocaleString()}`;
				const cls  = net >= 0 ? "log-win" : "log-lose";
				const solde = event.balance != null ? ` · solde ${event.balance.toLocaleString()}` : "";
				text = `${icon} <b>@${event.login}</b> · ${event.game} · mise ${event.bet.toLocaleString()} · <span class="${cls}">${diff} pts</span>${solde}`;
			}
			else if (event.action === "points")
			{
				const sign = event.amount > 0 ? "+" : "";
				const cls  = event.amount > 0 ? "log-win" : "log-lose";
				text = `💰 admin → <b>@${event.target}</b> · <span class="${cls}">${sign}${event.amount.toLocaleString()} pts</span> · solde ${event.newBalance.toLocaleString()}`;
			}
			else if (event.action === "reset-all")
			{
				text = `⚠️ <span class="log-warn">Reset général — tous remis à 1 000 pts</span>`;
			}
			else if (event.action === "gift")
			{
				const amt = event.amount != null ? ` · <span class="log-win">${event.amount.toLocaleString()} pts</span>` : "";
				const to  = event.target ? ` → <b>@${event.target}</b>` : "";
				text = `🎁 <b>@${event.login}</b>${to}${amt}`;
			}
			else if (event.action === "rain")
			{
				text = `🌧️ pluie par <b>@${event.login}</b> · ${(event.amount ?? 0).toLocaleString()} pts · ${event.winners ?? "?"} gagnants`;
			}
			else if (event.action === "treasure")
			{
				const what = event.kind === "rotd"
					? "💡 devinette du jour"
					: `🗺️ badge ${event.level ?? "?"}/${event.maxLevel ?? 17}`;
				text = `${what} · <b>@${event.login}</b> · <span class="log-win">+${(event.amount ?? 0).toLocaleString()} pts</span>`;
			}
			else if (event.action === "duel")
			{
				text = `⚔️ duel · <b>@${event.winner ?? "?"}</b> <span class="log-win">bat</span> <b>@${event.loser ?? "?"}</b> · mise ${(event.stake ?? 0).toLocaleString()} pts`;
			}
			else
			{
				// Action inconnue : dump compact plutôt que du JSON brut pleine ligne.
				const { type: _t, ts: _ts, action, ...rest } = event;
				text = `❓ ${action ?? "?"} · <small>${JSON.stringify(rest)}</small>`;
			}
			const li = document.createElement("li");
			li.className = "log-entry";
			li.innerHTML = `<span class="log-ts">${ts}</span>${text}`;
			return li;
		}

		async function loadHistory(page = 0)
		{
			try
			{
				const { logs, total } = await adminGetLogs({ ...getFilters(), limit: LIMIT, offset: page * LIMIT });
				currentPage = page;
				logList.innerHTML = "";
				if (!logs.length)
				{
					const li = document.createElement("li");
					li.className = "log-entry log-empty";
					li.textContent = "Aucun résultat.";
					logList.append(li);
				}
				else
				{
					for (const row of logs) logList.append(renderEntry({ ...row.payload, ts: row.ts, action: row.action }));
				}
				logCount.textContent = `${total.toLocaleString()} résultat${total !== 1 ? "s" : ""}`;
				logCount.hidden = false;
				const totalPages = Math.ceil(total / LIMIT);
				logPagination.hidden = totalPages <= 1;
				if (totalPages > 1)
				{
					$("[data-page-info]").textContent = `Page ${page + 1} / ${totalPages}`;
					($("[data-page-prev]") as HTMLButtonElement).disabled = page === 0;
					($("[data-page-next]") as HTMLButtonElement).disabled = page >= totalPages - 1;
				}
			} catch {
				logCount.textContent = "Erreur chargement.";
				logCount.hidden = false;
			}
		}

		// ── Login autocomplete picker ─────────────────────────────────────────
		let searchTimer: number;
		fLoginInput.addEventListener("input", () =>
		{
			clearTimeout(searchTimer);
			activeLogin = "";
			fLoginClear.hidden = true;
			const q = fLoginInput.value.trim();
			if (!q) { fResults.hidden = true; fResults.innerHTML = ""; return; }
			searchTimer = window.setTimeout(async () =>
			{
				const list = await adminSearch(q);
				fResults.innerHTML = list.length
					? list.map((u: any) =>
					{
							const av = u.image_url
								? `<img class="pav" src="${u.image_url}" width="28" height="28" alt="" />`
								: `<span class="pav fb">${u.login.charAt(0).toUpperCase()}</span>`;
							return `<li data-login="${u.login}">${av}<span>@${u.login}</span><small>${u.points.toLocaleString()} pts</small></li>`;
						}).join("")
					: `<li class="empty">Aucun résultat</li>`;
				fResults.hidden = false;
			}, 200);
		});
		fResults.addEventListener("click", async (e) =>
		{
			const li = (e.target as HTMLElement).closest<HTMLElement>("li[data-login]");
			if (!li) return;
			activeLogin = li.dataset.login!;
			fLoginInput.value = `@${activeLogin}`;
			fResults.hidden = true;
			fResults.innerHTML = "";
			fLoginClear.hidden = false;
			syncResetBtn();
			await loadHistory(0);
		});
		fLoginClear.addEventListener("click", async () =>
		{
			activeLogin = "";
			fLoginInput.value = "";
			fLoginClear.hidden = true;
			syncResetBtn();
			await loadHistory(0);
		});
		document.addEventListener("click", (e) =>
		{
			if (!(e.target as HTMLElement).closest(".flt-picker")) fResults.hidden = true;
		});

		// ── Controls ──────────────────────────────────────────────────────────
		$("[data-log-clear]").addEventListener("click", () =>
		{
			logList.innerHTML = "";
			logCount.hidden = true;
			logPagination.hidden = true;
		});
		const fltReset = $<HTMLButtonElement>("[data-f-reset]");
		function syncResetBtn()
		{
			fltReset.hidden = !activeLogin
				&& !$<HTMLSelectElement>("[data-f-action]").value
				&& !$<HTMLInputElement>("[data-f-from]").value
				&& !$<HTMLInputElement>("[data-f-to]").value;
		}
		const onFilterChange = () => { syncResetBtn(); loadHistory(0); };
		$("[data-f-action]").addEventListener("change", onFilterChange);
		$("[data-f-from]").addEventListener("change", onFilterChange);
		$("[data-f-to]").addEventListener("change", onFilterChange);
		fltReset.addEventListener("click", async () =>
		{
			activeLogin = "";
			fLoginInput.value = "";
			fLoginClear.hidden = true;
			$<HTMLSelectElement>("[data-f-action]").value = "";
			$<HTMLInputElement>("[data-f-from]").value = "";
			$<HTMLInputElement>("[data-f-to]").value = "";
			syncResetBtn();
			await loadHistory(0);
		});
		$("[data-page-prev]").addEventListener("click", () => loadHistory(currentPage - 1));
		$("[data-page-next]").addEventListener("click", () => loadHistory(currentPage + 1));

		// Initial load
		await loadHistory(0);

		connectRealtime();

		// WS events: toujours prepend si matche les filtres actifs
		onAdminLog((event) =>
		{
			if (!eventMatchesFilters(event)) return;
			// remove "no results" placeholder if present
			logList.querySelector(".log-empty")?.remove();
			const li = renderEntry(event);
			logList.prepend(li);
			while (logList.children.length > 200) logList.lastElementChild?.remove();
			logDot.classList.remove("pulse");
			void logDot.offsetWidth;
			logDot.classList.add("pulse");
		});
	});
</script>

