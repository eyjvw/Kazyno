---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const games = [
	{ href: "#poker",         name: "Poker",          tag: "Texas Hold'em · multijoueur",   emoji: "♠️", hot: true },
	{ href: "/games/crash",    name: "Crash",          tag: "Cashout avant le crash",       emoji: "📈", hot: true },
	{ href: "/games/mines",    name: "Mines",          tag: "Évite les bombes",              emoji: "💣", hot: true },
	{ href: "/games/roulette", name: "Roulette",       tag: "Européenne · 37 numéros",      emoji: "🎡", hot: true },
	{ href: "/games/tower",   name: "Tower",          tag: "Grimpe 8 étages · ~25× max",    emoji: "🗼", hot: true },
	{ href: "/games/hilo",    name: "Hi-Lo",          tag: "Plus haut ou plus bas ?",       emoji: "🃏" },
	{ href: "/games/wheel",   name: "Wheel",          tag: "50 segments · jusqu'à 5.5×",    emoji: "🛞" },
	{ href: "#blackjack",     name: "Blackjack",      tag: "Solo ou en ligne · multijoueur",emoji: "🃏" },
	{ href: "/games/dice",    name: "Dice",           tag: "Roll under / over",             emoji: "🎲" },
	{ href: "/games/limbo",   name: "Limbo",          tag: "Bust avant ta cible ?",         emoji: "🚀" },
	{ href: "/games/plinko",  name: "Plinko",         tag: "Laisse tomber la bille",        emoji: "🔻" },
	{ href: "/games/coinflip",name: "Coinflip",       tag: "Pile ou face · 1.98x",          emoji: "🪙" },
	{ href: "/games/slots",   name: "Machine à sous", tag: "3 rouleaux · jackpot 7️⃣",      emoji: "🎰" },
	{ href: "#keno",          name: "Keno",           tag: "10 numéros · jusqu'à 100×",     emoji: "🔢" },
];
---

<Layout title="PISCASINO — Lobby">
  <Nav />
  <main class="lobby">
    <section class="hero">
      <div class="hero-main panel">
        <p class="hello" data-hello>Salut 👋</p>
        <div class="balance">
          <span class="lbl">Ton solde</span>
          <span class="big"><b data-hero-balance>—</b> pts</span>
        </div>
        <a class="btn play-cta" href="/games/dice">Jouer maintenant →</a>
      </div>

      <div class="hero-side">
        <div class="stat-box panel jackpot-box">
          <span class="lbl">💰 Jackpot progressif</span>
          <b data-jackpot>—</b>
        </div>
        <div class="stat-box panel">
          <span class="lbl">Ton rang</span>
          <b data-rank>—</b>
        </div>
        <a class="stat-box panel link" href="/leaderboard">
          <span class="lbl">Classement</span>
          <b>Voir le top →</b>
        </a>
      </div>
    </section>

    <!-- Live win feed -->
    <section class="feed-section">
      <h2 class="section-title">🔥 Gros gains en direct</h2>
      <div class="feed-strip" data-feed>
        <span class="feed-empty" data-feed-empty>Aucun gros gain récent — à toi de jouer !</span>
      </div>
    </section>

    <!-- Weekly challenges widget -->
    <section class="challenges-section" data-challenges-section hidden>
      <h2 class="section-title">Défis de la semaine</h2>
      <div class="challenges-grid" data-challenges-grid></div>
    </section>

    <h2 class="section-title">Jeux</h2>
    <section class="grid">
      {
        games.map((g) => (
          <a class="card" href={g.href} data-bj={g.href === "#blackjack" ? "" : undefined} data-keno-open={g.href === "#keno" ? "" : undefined} data-pk-open={g.href === "#poker" ? "" : undefined}>
            <span class="emoji">{g.emoji}</span>
            <span class="meta">
              <b>{g.name}{(g as any).hot ? <span class="hot-badge">NEW</span> : ""}</b>
              <small>{g.tag}</small>
            </span>
            <span class="go">Jouer →</span>
          </a>
        ))
      }
    </section>
  </main>

  <!-- Daily reward modal -->
  <div class="daily-modal" data-daily-modal hidden>
    <div class="daily-card">
      <button class="daily-close" data-daily-close aria-label="Fermer">✕</button>
      <div class="daily-fire" data-daily-fire>🔥</div>
      <h2 class="daily-title">Récompense quotidienne</h2>
      <p class="daily-streak-txt" data-daily-streak-txt>Série de 0 jour</p>
      <div class="daily-days" data-daily-days></div>
      <button class="btn daily-claim-btn" data-daily-claim>Réclamer</button>
      <p class="daily-claimed-txt" data-daily-claimed-txt hidden>Reviens demain !</p>
    </div>
  </div>

  <!-- Blackjack modal -->
  <div class="daily-modal" data-bj-modal hidden>
    <div class="daily-card bj-card">
      <button class="daily-close" data-bj-close aria-label="Fermer">✕</button>
      <div class="daily-fire">🃏</div>
      <h2 class="daily-title">Blackjack</h2>

      <div class="bj-actions">
        <button class="bj-action" data-bj-solo>
          <span class="bja-ico">🤵</span>
          <span class="bja-meta"><b>Solo</b><small>Face au croupier, table privée</small></span>
        </button>
        <button class="bj-action" data-bj-create>
          <span class="bja-ico">➕</span>
          <span class="bja-meta"><b>Créer une table</b><small>Publique ou privée · 5 joueurs</small></span>
        </button>
      </div>

      <!-- Create table form (hidden until "Créer une table") -->
      <div class="bj-create-form" data-bj-form hidden>
        <input class="input" data-bj-name placeholder="Nom de la table (optionnel)" maxlength="40" />
        <div class="bj-vis">
          <button class="bjv is-active" data-vis="public">🌍 Publique<small>Visible par tous</small></button>
          <button class="bjv" data-vis="private">🔒 Privée<small>Code + invitations</small></button>
        </div>
        <button class="btn" data-bj-confirm>Créer la table</button>
      </div>

      <div class="bj-joinrow">
        <input class="input" data-bj-code placeholder="Code (ex: A3K7X)" maxlength="5" />
        <button class="btn" data-bj-joincode>Rejoindre</button>
      </div>

      <div class="bj-rooms-head">
        <span>Tables publiques</span>
        <button class="bj-refresh" data-bj-refresh>↻</button>
      </div>
      <div class="bj-rooms" data-bj-rooms>
        <span class="bj-empty">Chargement…</span>
      </div>
      <p class="bj-err" data-bj-err hidden></p>
    </div>
  </div>

  <!-- Poker modal -->
  <div class="daily-modal" data-pk-modal hidden>
    <div class="daily-card bj-card">
      <button class="daily-close" data-pk-close aria-label="Fermer">✕</button>
      <div class="daily-fire">♠️</div>
      <h2 class="daily-title">Poker</h2>

      <div class="bj-actions">
        <button class="bj-action" data-pk-create>
          <span class="bja-ico">➕</span>
          <span class="bja-meta"><b>Créer une table</b><small>Publique ou privée · Texas Hold'em</small></span>
        </button>
      </div>

      <div class="bj-create-form" data-pk-form hidden>
        <input class="input" data-pk-name placeholder="Nom de la table (optionnel)" maxlength="40" />
        <div class="bj-vis">
          <button class="bjv is-active" data-pk-vis="public">🌍 Publique<small>Visible par tous</small></button>
          <button class="bjv" data-pk-vis="private">🔒 Privée<small>Code + invitations</small></button>
        </div>
        <button class="btn" data-pk-confirm>Créer la table</button>
      </div>

      <div class="bj-joinrow">
        <input class="input" data-pk-code placeholder="Code (ex: A3K7X)" maxlength="5" />
        <button class="btn" data-pk-joincode>Rejoindre</button>
      </div>

      <div class="bj-rooms-head">
        <span>Tables publiques</span>
        <button class="bj-refresh" data-pk-refresh>↻</button>
      </div>
      <div class="bj-rooms" data-pk-rooms>
        <span class="bj-empty">Chargement…</span>
      </div>
      <p class="bj-err" data-pk-err hidden></p>
    </div>
  </div>

  <!-- Keno modal -->
  <div class="daily-modal" data-keno-modal hidden>
    <div class="daily-card keno-card">
      <button class="daily-close" data-keno-close aria-label="Fermer">✕</button>
      <div class="daily-fire">🔢</div>
      <h2 class="daily-title">Keno</h2>
      <iframe class="keno-frame" data-keno-frame title="Keno"></iframe>
    </div>
  </div>

  <Footer />
</Layout>

<script>
	import { loadMe, getMyRank, onBalance, fmt, getDailyStatus, claimDaily, getMyChallenges, onChallengeComplete, bjCreateRoom, bjListRooms, bjJoin, bjJoinByCode, bjStart, pokerCreateRoom, pokerListRooms, pokerJoin, pokerJoinByCode,getJackpot, onJackpot, getFeed, onFeed, type FeedItem } from "../lib/casino";

	const helloEl = document.querySelector<HTMLElement>("[data-hello]")!;
	const balEl = document.querySelector<HTMLElement>("[data-hero-balance]")!;
	const rankEl = document.querySelector<HTMLElement>("[data-rank]")!;
	const jackpotEl = document.querySelector<HTMLElement>("[data-jackpot]")!;

	onBalance((pts) => (balEl.textContent = fmt(pts)));

	// ── Jackpot ───────────────────────────────────────────────────────────────
	getJackpot().then((n) => (jackpotEl.textContent = `${fmt(n)} pts`));
	onJackpot((n) => (jackpotEl.textContent = `${fmt(n)} pts`));

	// ── Live feed ─────────────────────────────────────────────────────────────
	const feedEl = document.querySelector<HTMLElement>("[data-feed]")!;
	const feedEmpty = document.querySelector<HTMLElement>("[data-feed-empty]")!;

	function feedChip(item: FeedItem): HTMLElement
	{
		const el = document.createElement("div");
		el.className = "feed-chip";
		const mult = item.bet > 0 ? (item.payout / item.bet).toFixed(1) : "?";
		el.innerHTML = `
			<b>${item.display_name || item.login}</b>
			<span class="feed-game">${item.game}</span>
			<span class="feed-win">+${fmt(item.payout)} pts</span>
			<span class="feed-mult">×${mult}</span>`;
		return el;
	}

	function pushFeedChip(item: FeedItem, animate = true)
	{
		feedEmpty.hidden = true;
		const chip = feedChip(item);
		if (animate) chip.classList.add("pop");
		feedEl.prepend(chip);
		while (feedEl.querySelectorAll(".feed-chip").length > 12)
			feedEl.querySelector(".feed-chip:last-of-type")?.remove();
	}

	getFeed().then((items) => items.slice(0, 12).reverse().forEach((i) => pushFeedChip(i, false)));
	onFeed((item) => pushFeedChip(item));

	loadMe().then(async (me) =>
	{
		if (!me) return; // Nav handles redirect
		helloEl.textContent = `Salut, ${me.display_name || me.login} 👋`;

		const rank = await getMyRank();
		rankEl.textContent = rank ? `#${rank}` : "—";

		// Weekly challenges
		loadChallenges();

		// Daily reward modal — only if not yet claimed today
		const daily = await getDailyStatus();
		if (daily && !daily.claimed) showDailyModal(daily);
	});

	// ── Weekly challenges ─────────────────────────────────────────────────────
	const challengesSection = document.querySelector<HTMLElement>("[data-challenges-section]")!;
	const challengesGrid    = document.querySelector<HTMLElement>("[data-challenges-grid]")!;

	async function loadChallenges()
	{
		const list = await getMyChallenges();
		if (!list.length) return;
		challengesSection.hidden = false;
		challengesGrid.innerHTML = list.map((c: any) => `
			<div class="chal-card ${c.completed ? "done" : ""}">
				<span class="chal-ico">${c.icon}</span>
				<div class="chal-meta">
					<b>${c.desc}</b>
					<div class="chal-bar-wrap">
						<div class="chal-bar" style="width:${Math.min(100, Math.round(c.progress / c.target * 100))}%"></div>
					</div>
					<small>${c.progress}/${c.target} · +${fmt(c.reward)} pts</small>
				</div>
				${c.completed ? '<span class="chal-done">✓</span>' : ""}
			</div>`).join("");
	}

	onChallengeComplete(() => loadChallenges());

	// ── Daily modal ───────────────────────────────────────────────────────────
	const dailyModal    = document.querySelector<HTMLElement>("[data-daily-modal]")!;
	const dailyDaysEl   = document.querySelector<HTMLElement>("[data-daily-days]")!;
	const dailyStreakTxt= document.querySelector<HTMLElement>("[data-daily-streak-txt]")!;
	const dailyFireEl   = document.querySelector<HTMLElement>("[data-daily-fire]")!;
	const dailyClaimBtn = document.querySelector<HTMLButtonElement>("[data-daily-claim]")!;
	const dailyClaimedTxt = document.querySelector<HTMLElement>("[data-daily-claimed-txt]")!;

	const REWARDS = [50, 100, 150, 200, 300, 500, 1000];

	function showDailyModal(status: { streak: number; claimed: boolean; rewards: number[]; nextReward: number })
	{
		const { streak, claimed } = status;
		const rewards = status.rewards ?? REWARDS;

		// Current day index (0-6)
		const dayIdx = claimed ? (streak - 1) % 7 : streak % 7;

		dailyStreakTxt.textContent = streak > 1
			? `Série de ${streak} jour${streak > 1 ? "s" : ""} 🔥`
			: "Premier jour !";

		dailyFireEl.textContent = streak >= 7 ? "🔥🔥" : streak >= 3 ? "🔥" : "⭐";

		// Render 7 day boxes
		dailyDaysEl.innerHTML = "";
		for (let i = 0; i < 7; i++)
		{
			const isPast    = i < dayIdx;
			const isCurrent = i === dayIdx;
			const isFuture  = i > dayIdx;
			const box = document.createElement("div");
			box.className = `dday ${isPast ? "past" : isCurrent ? (claimed ? "claimed" : "current") : "future"}`;
			box.innerHTML = `
				<span class="dday-n">Jour ${i + 1}</span>
				<span class="dday-ico">${isPast || (isCurrent && claimed) ? "✓" : "🎁"}</span>
				<span class="dday-pts">${fmt(rewards[i])}</span>
				<span class="dday-unit">pts</span>`;
			dailyDaysEl.appendChild(box);
		}

		if (claimed)
		{
			dailyClaimBtn.hidden = true;
			dailyClaimedTxt.hidden = false;
		}
		else
		{
			dailyClaimBtn.textContent = `Réclamer ${fmt(status.nextReward)} pts`;
			dailyClaimBtn.hidden = false;
			dailyClaimedTxt.hidden = true;
		}

		dailyModal.hidden = false;
	}

	dailyClaimBtn.addEventListener("click", async () =>
	{
		dailyClaimBtn.disabled = true;
		try
		{
			const r = await claimDaily();
			// Refresh modal state
			dailyClaimBtn.hidden     = true;
			dailyClaimedTxt.hidden   = false;
			dailyStreakTxt.textContent = `Série de ${r.streak} jour${r.streak > 1 ? "s" : ""} 🔥`;
			// Re-render days with updated streak
			const updated = await getDailyStatus();
			if (updated) showDailyModal(updated);
		}
		catch (e: any)
		{
			dailyClaimBtn.disabled = false;
		}
	});

	document.querySelector("[data-daily-close]")?.addEventListener("click", () =>
	{
		dailyModal.hidden = true;
	});

	// Close on backdrop click
	dailyModal.addEventListener("click", (e) =>
	{
		if (e.target === dailyModal) dailyModal.hidden = true;
	});

	// ── Poker modal ───────────────────────────────────────────────────────────
	const pkModal   = document.querySelector<HTMLElement>("[data-pk-modal]")!;
	const pkRoomsEl = document.querySelector<HTMLElement>("[data-pk-rooms]")!;
	const pkCodeIn  = document.querySelector<HTMLInputElement>("[data-pk-code]")!;
	const pkErr     = document.querySelector<HTMLElement>("[data-pk-err]")!;
	const pkForm    = document.querySelector<HTMLElement>("[data-pk-form]")!;
	const pkNameIn  = document.querySelector<HTMLInputElement>("[data-pk-name]")!;
	let pkVis: "public" | "private" = "public";

	function pkError(msg: string)
	{
		pkErr.textContent = msg;
		pkErr.hidden = false;
	}

	async function pkRefreshRooms()
	{
		pkRoomsEl.innerHTML = `<span class="bj-empty">Chargement…</span>`;
		const rooms = await pokerListRooms();
		pkRoomsEl.innerHTML = rooms.length
			? rooms.map((r: any) => `
				<button class="bj-room" data-room="${r.id}">
					<span class="bjr-name">${r.name}</span>
					<span class="bjr-meta">${r.host} · ${r.players}/${r.maxSeats} · ${r.phase === "waiting" ? "en attente" : "en jeu"}</span>
					<span class="bjr-go">→</span>
				</button>`).join("")
			: `<span class="bj-empty">Aucune table publique — crée la tienne !</span>`;
	}

	document.querySelector("[data-pk-open]")?.addEventListener("click", (e) =>
	{
		e.preventDefault();
		pkErr.hidden = true;
		pkModal.hidden = false;
		void pkRefreshRooms();
	});
	document.querySelector("[data-pk-close]")?.addEventListener("click", () => (pkModal.hidden = true));
	pkModal.addEventListener("click", (e) =>
	{
		if (e.target === pkModal) pkModal.hidden = true;
	});
	document.querySelector("[data-pk-refresh]")?.addEventListener("click", () => void pkRefreshRooms());

	document.querySelector("[data-pk-create]")?.addEventListener("click", () =>
	{
		pkForm.hidden = !pkForm.hidden;
		if (!pkForm.hidden) pkNameIn.focus();
	});

	document.querySelectorAll<HTMLButtonElement>("[data-pk-vis]").forEach((b) =>
	{
		b.addEventListener("click", () =>
		{
			pkVis = b.dataset.pkVis as "public" | "private";
			document.querySelectorAll("[data-pk-vis]").forEach((x) => x.classList.toggle("is-active", x === b));
		});
	});

	document.querySelector<HTMLButtonElement>("[data-pk-confirm]")?.addEventListener("click", async (e) =>
	{
		const btn = e.currentTarget as HTMLButtonElement;
		btn.disabled = true;
		try
		{
			const r = await pokerCreateRoom(pkNameIn.value.trim(), pkVis === "public");
			location.href = `/games/poker?room=${r.id}`;
		}
		catch (err: any)
		{
			pkError(err?.message ?? "Erreur");
			btn.disabled = false;
		}
	});

	document.querySelector("[data-pk-joincode]")?.addEventListener("click", async () =>
	{
		const code = pkCodeIn.value.trim();
		if (code.length < 4) return pkError("Code invalide");
		try
		{
			const r = await pokerJoinByCode(code);
			location.href = `/games/poker?room=${r.id}`;
		}
		catch (err: any)
		{
			pkError(err?.message ?? "Room introuvable");
		}
	});

	pkRoomsEl.addEventListener("click", async (e) =>
	{
		const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-room]");
		if (!btn) return;
		try
		{
			const r = await pokerJoin(btn.dataset.room!);
			location.href = `/games/poker?room=${r.id}`;
		}
		catch (err: any)
		{
			pkError(err?.message ?? "Impossible de rejoindre");
			void pkRefreshRooms();
		}
	});

	// ── Keno modal ────────────────────────────────────────────────────────────
	const kenoModal = document.querySelector<HTMLElement>("[data-keno-modal]")!;
	const kenoFrame = document.querySelector<HTMLIFrameElement>("[data-keno-frame]")!;

	document.querySelector("[data-keno-open]")?.addEventListener("click", (e) =>
	{
		e.preventDefault();
		// iframe chargée à la première ouverture seulement
		if (!kenoFrame.src) kenoFrame.src = "/games/keno?embed=1";
		kenoModal.hidden = false;
	});
	document.querySelector("[data-keno-close]")?.addEventListener("click", () => (kenoModal.hidden = true));
	kenoModal.addEventListener("click", (e) =>
	{
		if (e.target === kenoModal) kenoModal.hidden = true;
	});

	// ── Blackjack modal ───────────────────────────────────────────────────────
	const bjModal   = document.querySelector<HTMLElement>("[data-bj-modal]")!;
	const bjRoomsEl = document.querySelector<HTMLElement>("[data-bj-rooms]")!;
	const bjCodeIn  = document.querySelector<HTMLInputElement>("[data-bj-code]")!;
	const bjErr     = document.querySelector<HTMLElement>("[data-bj-err]")!;

	function bjError(msg: string)
	{
		bjErr.textContent = msg;
		bjErr.hidden = false;
	}

	async function refreshRooms()
	{
		bjRoomsEl.innerHTML = `<span class="bj-empty">Chargement…</span>`;
		const rooms = await bjListRooms();
		bjRoomsEl.innerHTML = rooms.length
			? rooms.map((r: any) => `
				<button class="bj-room" data-room="${r.id}">
					<span class="bjr-name">${r.name}</span>
					<span class="bjr-meta">${r.host} · ${r.players}/${r.maxSeats}</span>
					<span class="bjr-go">→</span>
				</button>`).join("")
			: `<span class="bj-empty">Aucune table publique — crée la tienne !</span>`;
	}

	document.querySelector("[data-bj]")?.addEventListener("click", (e) =>
	{
		e.preventDefault();
		bjErr.hidden = true;
		bjModal.hidden = false;
		void refreshRooms();
	});

	document.querySelector("[data-bj-close]")?.addEventListener("click", () => (bjModal.hidden = true));
	bjModal.addEventListener("click", (e) =>
	{
		if (e.target === bjModal) bjModal.hidden = true;
	});

	document.querySelector("[data-bj-refresh]")?.addEventListener("click", () => void refreshRooms());

	document.querySelector<HTMLButtonElement>("[data-bj-solo]")?.addEventListener("click", async (e) =>
	{
		const btn = e.currentTarget as HTMLButtonElement;
		btn.disabled = true;
		try
		{
			const r = await bjCreateRoom("Solo vs croupier", false);
			await bjStart(r.id).catch(() => {}); // lance direct la phase de mise
			location.href = `/table?room=${r.id}`;
		}
		catch (err: any)
		{
			bjError(err?.message ?? "Erreur");
			btn.disabled = false;
		}
	});

	// "Créer une table" → affiche le formulaire nom + visibilité
	const bjForm   = document.querySelector<HTMLElement>("[data-bj-form]")!;
	const bjNameIn = document.querySelector<HTMLInputElement>("[data-bj-name]")!;
	let bjVis: "public" | "private" = "public";

	document.querySelector("[data-bj-create]")?.addEventListener("click", () =>
	{
		bjForm.hidden = !bjForm.hidden;
		if (!bjForm.hidden) bjNameIn.focus();
	});

	document.querySelectorAll<HTMLButtonElement>("[data-vis]").forEach((b) =>
	{
		b.addEventListener("click", () =>
		{
			bjVis = b.dataset.vis as "public" | "private";
			document.querySelectorAll("[data-vis]").forEach((x) => x.classList.toggle("is-active", x === b));
		});
	});

	document.querySelector<HTMLButtonElement>("[data-bj-confirm]")?.addEventListener("click", async (e) =>
	{
		const btn = e.currentTarget as HTMLButtonElement;
		btn.disabled = true;
		try
		{
			const r = await bjCreateRoom(bjNameIn.value.trim(), bjVis === "public");
			location.href = `/table?room=${r.id}`;
		}
		catch (err: any)
		{
			bjError(err?.message ?? "Erreur");
			btn.disabled = false;
		}
	});

	document.querySelector("[data-bj-joincode]")?.addEventListener("click", async () =>
	{
		const code = bjCodeIn.value.trim();
		if (code.length < 4) return bjError("Code invalide");
		try
		{
			const r = await bjJoinByCode(code);
			location.href = `/table?room=${r.id}`;
		}
		catch (err: any)
		{
			bjError(err?.message ?? "Room introuvable");
		}
	});

	bjRoomsEl.addEventListener("click", async (e) =>
	{
		const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-room]");
		if (!btn) return;
		try
		{
			const r = await bjJoin(btn.dataset.room!);
			location.href = `/table?room=${r.id}`;
		}
		catch (err: any)
		{
			bjError(err?.message ?? "Impossible de rejoindre");
			void refreshRooms();
		}
	});

</script>

