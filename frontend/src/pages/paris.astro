---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Kazyno — Paris">
  <Nav />
  <main class="wrap">
    <header class="head">
      <h1>Paris</h1>
      <p>Prédis ta note d'exam ou parie sur les vrais matchs de foot — tout en points, rien en euros.</p>
    </header>

    <div class="tabs" role="tablist">
      <button class="tab is-active" data-tab="exam" role="tab">🎓 Exams</button>
      <button class="tab" data-tab="foot" role="tab">⚽ Foot</button>
    </div>

    <!-- ═══ Onglet Exams ═══ -->
    <div data-panel="exam">
      <div class="baremes-row">
        <div class="bareme-card panel">
          <div class="bt">Standard (×10)</div>
          <div class="br"><span>Exact</span><b>10×</b></div>
          <div class="br"><span>±10</span><b>3×</b></div>
          <div class="br"><span>±20</span><b>1.5×</b></div>
          <div class="br"><span>±30</span><b>remboursé</b></div>
          <div class="br dim"><span>au-delà</span><b>perdu</b></div>
        </div>
        <div class="bareme-card panel">
          <div class="bt">Final (×6)</div>
          <div class="br"><span>Exact</span><b>10×</b></div>
          <div class="br"><span>±6</span><b>3×</b></div>
          <div class="br"><span>±12</span><b>1.5×</b></div>
          <div class="br"><span>±18</span><b>remboursé</b></div>
          <div class="br dim"><span>au-delà</span><b>perdu</b></div>
        </div>
      </div>

      <section class="exams-section">
        <h2 class="section-title">Examens à venir</h2>
        <div class="exam-cards" data-exam-cards>
          <p class="loading">Chargement…</p>
        </div>
      </section>

      <section class="history-section">
        <h2 class="section-title">Mes paris réglés</h2>
        <ul class="feed" data-history><li class="empty">Aucun pari réglé.</li></ul>
      </section>

      <section class="feed-section">
        <h2 class="section-title">Derniers résultats</h2>
        <ul class="feed" data-feed><li class="empty">Chargement…</li></ul>
      </section>
    </div>

    <!-- ═══ Onglet Foot ═══ -->
    <div data-panel="foot" hidden>
      <p class="foot-lede">Cotes réelles des bookmakers, gains en points. La cote est verrouillée au moment de ta mise, pari annulable jusqu'au coup d'envoi.</p>

      <section class="matches-section">
        <h2 class="section-title">Matchs à venir</h2>
        <div class="match-groups" data-matches>
          <p class="loading">Chargement…</p>
        </div>
      </section>

      <section class="history-section">
        <h2 class="section-title">Mes paris réglés</h2>
        <ul class="feed" data-foot-history><li class="empty">Aucun pari réglé.</li></ul>
      </section>

      <section class="feed-section">
        <h2 class="section-title">Derniers résultats</h2>
        <ul class="feed" data-foot-feed><li class="empty">Chargement…</li></ul>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
	import {
		loadMe,
		getExamsWithCtx,
		getExamBets,
		type ExamCtx,
		getExamFeed,
		placeExamBet,
		modifyExamBet,
		cancelExamBet,
		onExamSettled,
		getFootMatches,
		getFootBets,
		getFootFeed,
		placeFootBet,
		cancelFootBet,
		onFootSettled,
		getBalance,
		fmt,
	} from "../lib/casino";

	const $ = <T extends HTMLElement>(s: string, root: ParentNode = document) =>
		root.querySelector<T>(s)!;
	const $$ = <T extends HTMLElement>(s: string, root: ParentNode = document) =>
		[...root.querySelectorAll<T>(s)];

	// ── Tabs ────────────────────────────────────────────────────────────────
	function showTab(name: string)
	{
		$$("[data-tab]").forEach((b) => b.classList.toggle("is-active", b.dataset.tab === name));
		$$("[data-panel]").forEach((p) => { (p as HTMLElement).hidden = p.dataset.panel !== name; });
		history.replaceState(null, "", name === "foot" ? "#foot" : "#");
	}
	$$("[data-tab]").forEach((b) =>
		b.addEventListener("click", () => showTab((b as HTMLButtonElement).dataset.tab!)));
	if (location.hash === "#foot") showTab("foot");

	// ═══════════════════════ Paris d'exam ═══════════════════════
	const cardsEl = $("[data-exam-cards]");
	const histEl  = $("[data-history]");
	const feedEl  = $("[data-feed]");

	const SCORES: Record<string, number[]> = {
		standard: Array.from({ length: 11 }, (_, i) => i * 10),
		final: (() =>
		{
			const s: number[] = [];
			for (let i = 0; i <= 96; i += 6) s.push(i);
			s.push(100);
			return s;
		})(),
	};

	function examType(exam: any): string
	{
		return exam.is_final ? "final" : "standard";
	}

	function renderPicker(container: HTMLElement, scores: number[], selected: number, onPick: (v: number) => void)
	{
		container.innerHTML = "";
		scores.forEach((s) =>
		{
			const btn = document.createElement("button");
			btn.className = "score-btn" + (s === selected ? " is-active" : "");
			btn.textContent = String(s);
			btn.addEventListener("click", () =>
			{
				$$(".score-btn", container).forEach((b) => b.classList.remove("is-active"));
				btn.classList.add("is-active");
				onPick(s);
			});
			container.appendChild(btn);
		});
	}

	function countdown(dateStr: string): string
	{
		const diff = new Date(dateStr).getTime() - Date.now();
		if (diff <= 0) return "Passé";
		const d = Math.floor(diff / 86400000);
		const h = Math.floor((diff % 86400000) / 3600000);
		const m = Math.floor((diff % 3600000) / 60000);
		if (d > 0) return `J-${d}`;
		if (h > 0) return `${h}h ${m}m`;
		return `${m}m`;
	}

	// ── Render a single exam card ───────────────────────────────────────────
	function renderCard(exam: any, existingBet: any | null, container: HTMLElement)
	{
		container.innerHTML = "";

		const type   = examType(exam);
		const scores = SCORES[type];
		const date   = new Date(exam.exam_date).toLocaleString("fr-FR", { dateStyle: "long", timeStyle: "short" });
		const locked = exam.locked || new Date(exam.exam_date) < new Date();

		// Header
		const hdr = document.createElement("div");
		hdr.className = "ec-header";
		hdr.innerHTML = `
			<div class="ec-title">${exam.label}</div>
			<div class="ec-meta">
				<span class="ec-type ${type}">${exam.is_final ? "Final" : "Standard"}</span>
				<span class="ec-date">${date}</span>
				${!locked ? `<span class="ec-countdown">${countdown(exam.exam_date)}</span>` : ""}
			</div>`;
		container.appendChild(hdr);

		if (locked)
		{
			if (existingBet)
			{
				const info = document.createElement("div");
				info.className = "ec-bet-locked";
				info.innerHTML = `
					<div class="pred-big">${existingBet.predicted}<small>/100</small></div>
					<div class="bet-locked-meta">
						<span class="stake-info">Mise · <b>${fmt(existingBet.stake)} pts</b></span>
						<span class="bet-locked-badge">En attente</span>
					</div>`;
				container.appendChild(info);
			}
			else
			{
				const badge = document.createElement("div");
				badge.className = "ec-locked";
				badge.textContent = "Verrouillé — paris fermés";
				container.appendChild(badge);
			}
			return;
		}

		if (existingBet)
		{
			renderBetManage(container, exam, existingBet);
		}
		else
		{
			renderBetForm(container, exam);
		}
	}

	function renderBetForm(container: HTMLElement, exam: any)
	{
		const type   = examType(exam);
		const scores = SCORES[type];
		let predicted = scores[Math.floor(scores.length / 2)];

		const body = document.createElement("div");
		body.className = "ec-body";
		body.innerHTML = `
			<label class="ec-lbl">Prédiction</label>
			<div class="score-grid" data-picker></div>
			<div class="pred-display"><span data-predval>${predicted}</span><small>/100</small></div>
			<label class="ec-lbl">Mise</label>
			<input class="input" data-stake type="number" min="10" value="100" />
			<div class="chips" style="margin-top:6px">
				<button data-amt="half">½</button>
				<button data-amt="double">2×</button>
				<button data-amt="max">Max</button>
			</div>
			<button class="btn" data-place style="margin-top:14px">Parier</button>
			<p class="ec-err" data-err></p>`;
		container.appendChild(body);

		const picker  = $<HTMLDivElement>("[data-picker]", body);
		const predVal = $<HTMLSpanElement>("[data-predval]", body);
		const stakeEl = $<HTMLInputElement>("[data-stake]", body);
		const errEl   = $<HTMLParagraphElement>("[data-err]", body);

		renderPicker(picker, scores, predicted, (v) => { predicted = v; predVal.textContent = String(v); });

		$$("[data-amt]", body).forEach((b) =>
		{
			b.addEventListener("click", () =>
			{
				const cur = Math.max(10, Math.floor(Number(stakeEl.value) || 10));
				const m = (b as HTMLButtonElement).dataset.amt;
				if (m === "half")   stakeEl.value = String(Math.max(10, Math.floor(cur / 2)));
				else if (m === "double") stakeEl.value = String(Math.min(1_000_000, cur * 2));
				else if (m === "max")    stakeEl.value = String(Math.max(10, getBalance()));
			});
		});

		$("[data-place]", body).addEventListener("click", async () =>
		{
			errEl.textContent = "";
			const stake = Math.floor(Number(stakeEl.value));
			if (stake < 10) { errEl.textContent = "Mise min 10 pts"; return; }
			const btn = $<HTMLButtonElement>("[data-place]", body);
			btn.disabled = true;
			try
			{
				await placeExamBet(exam.id, predicted, stake);
				await refresh();
			}
			catch (e: any)
			{
				errEl.textContent = e?.message ?? "Erreur";
				btn.disabled = false;
			}
		});
	}

	function renderBetManage(container: HTMLElement, exam: any, bet: any, editing = false)
	{
		const type   = examType(exam);
		const scores = SCORES[type];

		if (!editing)
		{
			const body = document.createElement("div");
			body.className = "ec-body ec-manage";
			body.innerHTML = `
				<div class="ec-pending-info">
					<div class="pred-big">${bet.predicted}<small>/100</small></div>
					<span class="stake-info">Mise : <b>${fmt(bet.stake)} pts</b></span>
					<span class="wait">En attente de ta note d'exam…</span>
				</div>
				<div class="manage-btns">
					<button class="btn btn-outline" data-edit>Modifier</button>
					<button class="btn btn-danger" data-cancel>Annuler (+${fmt(bet.stake)} remboursés)</button>
				</div>
				<p class="ec-err" data-err></p>`;
			container.appendChild(body);

			$("[data-edit]", body).addEventListener("click", () =>
			{
				const newBody = container.querySelector(".ec-body");
				if (newBody) newBody.remove();
				renderBetManage(container, exam, bet, true);
			});
			$("[data-cancel]", body).addEventListener("click", async () =>
			{
				const btn = $<HTMLButtonElement>("[data-cancel]", body);
				btn.disabled = true;
				try
				{
					await cancelExamBet(bet.id);
					await refresh();
				}
				catch (e: any)
				{
					($("[data-err]", body) as HTMLElement).textContent = e?.message ?? "Erreur";
					btn.disabled = false;
				}
			});
		}
		else
		{
			let predicted = scores.includes(bet.predicted) ? bet.predicted : scores[Math.floor(scores.length / 2)];

			const body = document.createElement("div");
			body.className = "ec-body";
			body.innerHTML = `
				<div class="edit-header">
					<span class="ec-lbl" style="margin:0">Modifier</span>
					<button class="back-link" data-back>← Annuler modif</button>
				</div>
				<label class="ec-lbl">Prédiction</label>
				<div class="score-grid" data-picker></div>
				<div class="pred-display"><span data-predval>${predicted}</span><small>/100</small></div>
				<label class="ec-lbl">Mise</label>
				<input class="input" data-stake type="number" min="10" value="${bet.stake}" />
				<div class="chips" style="margin-top:6px">
					<button data-amt="half">½</button>
					<button data-amt="double">2×</button>
				</div>
				<button class="btn" data-save style="margin-top:14px">Enregistrer</button>
				<p class="ec-err" data-err></p>`;
			container.appendChild(body);

			const picker  = $<HTMLDivElement>("[data-picker]", body);
			const predVal = $<HTMLSpanElement>("[data-predval]", body);
			const stakeEl = $<HTMLInputElement>("[data-stake]", body);
			const errEl   = $<HTMLParagraphElement>("[data-err]", body);

			renderPicker(picker, scores, predicted, (v) => { predicted = v; predVal.textContent = String(v); });

			$$("[data-amt]", body).forEach((b) =>
			{
				b.addEventListener("click", () =>
				{
					const cur = Math.max(10, Math.floor(Number(stakeEl.value) || 10));
					const m = (b as HTMLButtonElement).dataset.amt;
					if (m === "half")   stakeEl.value = String(Math.max(10, Math.floor(cur / 2)));
					else if (m === "double") stakeEl.value = String(Math.min(1_000_000, cur * 2));
				});
			});

			$("[data-back]", body).addEventListener("click", () =>
			{
				body.remove();
				renderBetManage(container, exam, bet, false);
			});
			$("[data-save]", body).addEventListener("click", async () =>
			{
				errEl.textContent = "";
				const stake = Math.floor(Number(stakeEl.value));
				if (stake < 10) { errEl.textContent = "Mise min 10 pts"; return; }
				const btn = $<HTMLButtonElement>("[data-save]", body);
				btn.disabled = true;
				try
				{
					await modifyExamBet(bet.id, predicted, stake);
					await refresh();
				}
				catch (e: any)
				{
					errEl.textContent = e?.message ?? "Erreur";
					btn.disabled = false;
				}
			});
		}
	}

	// ── Render all exam cards ───────────────────────────────────────────────
	function renderExamCards(exams: any[], pendingBets: any[], ctx: ExamCtx | null)
	{
		// Common core done: exam bets are over for this player.
		if (ctx?.common_core_done)
		{
			cardsEl.innerHTML = `
				<div class="core-done panel">
					<span class="cd-emoji">🎓</span>
					<b>Tronc commun terminé !</b>
					<p>Plus d'exams à parier pour toi — les +2000 pts de félicitations sont déjà sur ton compte. Profite du casino.</p>
				</div>`;
			return;
		}

		// Filter to upcoming or recently locked (last 7 days)
		const cutoff = Date.now() - 7 * 86400000;
		const visible = exams.filter((e) => !e.locked || new Date(e.exam_date).getTime() > cutoff);

		if (!visible.length)
		{
			cardsEl.innerHTML = `<p class="empty-state">Aucun exam planifié pour l'instant.</p>`;
			return;
		}

		cardsEl.innerHTML = "";
		const betByExam = new Map(pendingBets.map((b: any) => [b.exam_id, b]));
		const rankLabel = (r: number) => (r === 0 ? "l'exam Piscine" : `l'Exam 0${r}`);

		visible.forEach((exam) =>
		{
			const card = document.createElement("div");
			// Rank-reserved exam the viewer isn't registered to: visible but not bettable.
			const rankLocked = exam.rank != null && ctx != null && ctx.exam_rank !== exam.rank;
			card.className = `exam-card panel${exam.locked || rankLocked ? " locked" : ""}`;
			cardsEl.appendChild(card);
			if (rankLocked)
			{
				const date = new Date(exam.exam_date).toLocaleString("fr-FR", { dateStyle: "long", timeStyle: "short" });
				card.innerHTML = `
					<div class="ec-header">
						<div class="ec-title">${exam.label}</div>
						<div class="ec-meta">
							<span class="ec-type ${exam.is_final ? "final" : "standard"}">${exam.is_final ? "Final" : "Standard"}</span>
							<span class="ec-date">${date}</span>
						</div>
					</div>
					<div class="ec-locked">Réservé aux inscrits à ${rankLabel(exam.rank)} — ${ctx!.exam_rank == null ? "tu n'es inscrit à aucun exam sur l'intra." : `tu es inscrit à ${rankLabel(ctx!.exam_rank)}.`}</div>`;
				return;
			}
			renderCard(exam, betByExam.get(exam.id) ?? null, card);
		});
	}

	// ── History & feed ──────────────────────────────────────────────────────
	function renderHistory(history: any[])
	{
		histEl.innerHTML = history.length
			? history.map((h) =>
			{
					const win = h.payout > 0;
					const label = h.exam_label ?? (h.exam_type === "final" ? "Final" : "Standard");
					return `<li class="frow">
						<div class="frow-main">
							<span class="fn">${label}</span>
							<span class="fp">Prédit <b>${h.predicted}</b> · Réel <b>${h.actual}</b></span>
						</div>
						<div class="frow-right">
							<span class="fr ${win ? "win" : "lose"}">${win ? "+" + fmt(h.payout) + " pts" : "−" + fmt(h.stake) + " pts"}</span>
							<span class="fmult">${h.multiplier}×</span>
						</div>
					</li>`;
				}).join("")
			: `<li class="empty">Aucun pari réglé.</li>`;
	}

	function renderFeed(feed: any[])
	{
		feedEl.innerHTML = feed.length
			? feed.map((f) =>
			{
					const av = f.image_url
						? `<img class="fav" src="${f.image_url}" width="28" height="28" alt="" />`
						: `<span class="fav fb">${f.login.charAt(0).toUpperCase()}</span>`;
					const win = f.payout > 0;
					const label = f.exam_label ?? (f.exam_type === "final" ? "Final" : "Standard");
					return `<li class="frow">
						${av}
						<div class="frow-main">
							<span class="fn">@${f.login}</span>
							<span class="fp">${label} · prédit ${f.predicted} · réel ${f.actual}</span>
						</div>
						<span class="fr ${win ? "win" : "lose"}">${win ? "+" + fmt(f.payout) : "−" + fmt(f.stake ?? 0)}</span>
					</li>`;
				}).join("")
			: `<li class="empty">Aucun résultat pour l'instant.</li>`;
	}

	async function refresh()
	{
		const [examsData, myBets, feed] = await Promise.all([getExamsWithCtx(), getExamBets(), getExamFeed()]);
		renderExamCards(examsData.exams, myBets.pending ?? [], examsData.ctx);
		renderHistory(myBets.history ?? []);
		renderFeed(feed);
	}

	// ═══════════════════════ Paris foot ═══════════════════════
	const matchesEl  = $("[data-matches]");
	const footHistEl = $("[data-foot-history]");
	const footFeedEl = $("[data-foot-feed]");

	const PICK_LABEL: Record<string, string> = { home: "1", draw: "N", away: "2" };

	function pickName(m: any, pick: string): string
	{
		return pick === "home" ? m.home : pick === "away" ? m.away : "Nul";
	}

	function footCountdown(dateStr: string): string
	{
		const diff = new Date(dateStr).getTime() - Date.now();
		if (diff <= 0) return "En cours";
		return countdown(dateStr);
	}

	// ── One match card ──────────────────────────────────────────────────────
	function renderMatchCard(match: any, existingBet: any | null, container: HTMLElement)
	{
		container.innerHTML = "";
		const started = new Date(match.commence_at) <= new Date();
		const date = new Date(match.commence_at).toLocaleString("fr-FR", { dateStyle: "medium", timeStyle: "short" });

		const hdr = document.createElement("div");
		hdr.className = "mc-header";
		hdr.innerHTML = `
			<div class="mc-teams"><b>${match.home}</b><span class="vs">vs</span><b>${match.away}</b></div>
			<div class="mc-meta">
				<span class="mc-date">${date}</span>
				<span class="mc-countdown ${started ? "live" : ""}">${footCountdown(match.commence_at)}</span>
				${match.bet_count ? `<span class="mc-count">${match.bet_count} pari(s)</span>` : ""}
			</div>`;
		container.appendChild(hdr);

		if (existingBet)
		{
			renderFootManage(container, match, existingBet, started);
			return;
		}
		if (started)
		{
			const badge = document.createElement("div");
			badge.className = "mc-locked";
			badge.textContent = "Match commencé — paris fermés";
			container.appendChild(badge);
			return;
		}
		renderFootForm(container, match);
	}

	function renderFootForm(container: HTMLElement, match: any)
	{
		let pick: string | null = null;

		const body = document.createElement("div");
		body.className = "mc-body";
		body.innerHTML = `
			<div class="odds-row">
				<button class="odd-btn" data-pick="home"><span class="ol">1 · ${match.home}</span><b>${match.odds_home}</b></button>
				<button class="odd-btn" data-pick="draw"><span class="ol">N · Nul</span><b>${match.odds_draw}</b></button>
				<button class="odd-btn" data-pick="away"><span class="ol">2 · ${match.away}</span><b>${match.odds_away}</b></button>
			</div>
			<label class="ec-lbl">Mise</label>
			<input class="input" data-stake type="number" min="10" value="100" />
			<div class="chips" style="margin-top:6px">
				<button data-amt="half">½</button>
				<button data-amt="double">2×</button>
				<button data-amt="max">Max</button>
			</div>
			<div class="gain" data-gain hidden>Gain potentiel : <b data-gainval></b></div>
			<button class="btn" data-place style="margin-top:12px" disabled>Choisis un résultat</button>
			<p class="ec-err" data-err></p>`;
		container.appendChild(body);

		const stakeEl  = $<HTMLInputElement>("[data-stake]", body);
		const errEl    = $<HTMLParagraphElement>("[data-err]", body);
		const placeBtn = $<HTMLButtonElement>("[data-place]", body);
		const gainEl   = $<HTMLDivElement>("[data-gain]", body);
		const gainVal  = $<HTMLElement>("[data-gainval]", body);

		function oddsFor(p: string): number
		{
			return p === "home" ? match.odds_home : p === "draw" ? match.odds_draw : match.odds_away;
		}
		function updateGain()
		{
			if (!pick) { gainEl.hidden = true; return; }
			const stake = Math.max(0, Math.floor(Number(stakeEl.value) || 0));
			gainVal.textContent = `${fmt(Math.floor(stake * oddsFor(pick)))} pts (${oddsFor(pick)}×)`;
			gainEl.hidden = false;
		}

		$$("[data-pick]", body).forEach((b) =>
		{
			b.addEventListener("click", () =>
			{
				$$(".odd-btn", body).forEach((x) => x.classList.remove("is-active"));
				b.classList.add("is-active");
				pick = (b as HTMLButtonElement).dataset.pick!;
				placeBtn.disabled = false;
				placeBtn.textContent = "Parier";
				updateGain();
			});
		});
		stakeEl.addEventListener("input", updateGain);

		$$("[data-amt]", body).forEach((b) =>
		{
			b.addEventListener("click", () =>
			{
				const cur = Math.max(10, Math.floor(Number(stakeEl.value) || 10));
				const m = (b as HTMLButtonElement).dataset.amt;
				if (m === "half")        stakeEl.value = String(Math.max(10, Math.floor(cur / 2)));
				else if (m === "double") stakeEl.value = String(Math.min(1_000_000, cur * 2));
				else if (m === "max")    stakeEl.value = String(Math.max(10, getBalance()));
				updateGain();
			});
		});

		placeBtn.addEventListener("click", async () =>
		{
			errEl.textContent = "";
			if (!pick) return;
			const stake = Math.floor(Number(stakeEl.value));
			if (stake < 10) { errEl.textContent = "Mise min 10 pts"; return; }
			placeBtn.disabled = true;
			try
			{
				await placeFootBet(match.id, pick, stake);
				await refreshFoot();
			}
			catch (e: any)
			{
				errEl.textContent = e?.message ?? "Erreur";
				placeBtn.disabled = false;
			}
		});
	}

	function renderFootManage(container: HTMLElement, match: any, bet: any, started: boolean)
	{
		const potential = Math.floor(bet.stake * bet.odds);
		const body = document.createElement("div");
		body.className = "ec-body ec-manage";
		body.innerHTML = `
			<div class="ec-pending-info">
				<div class="pick-big">${PICK_LABEL[bet.pick]}<small> · ${pickName(match, bet.pick)}</small></div>
				<span class="stake-info">Mise <b>${fmt(bet.stake)} pts</b> à <b>${bet.odds}×</b> → gain potentiel <b>${fmt(potential)} pts</b></span>
				<span class="wait">${started ? "Match en cours…" : "En attente du coup d'envoi…"}</span>
			</div>
			${started ? "" : `
			<div class="manage-btns">
				<button class="btn btn-danger" data-cancel>Annuler (+${fmt(bet.stake)} remboursés)</button>
			</div>`}
			<p class="ec-err" data-err></p>`;
		container.appendChild(body);

		const cancelBtn = body.querySelector<HTMLButtonElement>("[data-cancel]");
		cancelBtn?.addEventListener("click", async () =>
		{
			cancelBtn.disabled = true;
			try
			{
				await cancelFootBet(bet.id);
				await refreshFoot();
			}
			catch (e: any)
			{
				($("[data-err]", body) as HTMLElement).textContent = e?.message ?? "Erreur";
				cancelBtn.disabled = false;
			}
		});
	}

	// ── All matches, grouped by league ──────────────────────────────────────
	function renderMatches(matches: any[], pendingBets: any[])
	{
		if (!matches.length)
		{
			matchesEl.innerHTML = `<p class="empty-state">Aucun match à venir pour l'instant — repasse un peu plus tard.</p>`;
			return;
		}

		matchesEl.innerHTML = "";
		const betByMatch = new Map(pendingBets.map((b: any) => [b.match_id, b]));

		const byLeague = new Map<string, any[]>();
		matches.forEach((m) =>
		{
			if (!byLeague.has(m.league)) byLeague.set(m.league, []);
			byLeague.get(m.league)!.push(m);
		});

		byLeague.forEach((ms, league) =>
		{
			const group = document.createElement("div");
			group.className = "league-group";
			group.innerHTML = `<h3 class="league-title">${league}</h3>`;
			const grid = document.createElement("div");
			grid.className = "match-cards";
			group.appendChild(grid);
			matchesEl.appendChild(group);

			ms.forEach((m) =>
			{
				const started = new Date(m.commence_at) <= new Date();
				const card = document.createElement("div");
				card.className = `exam-card panel${started ? " locked" : ""}`;
				grid.appendChild(card);
				renderMatchCard(m, betByMatch.get(m.id) ?? null, card);
			});
		});
	}

	function renderFootHistory(history: any[])
	{
		footHistEl.innerHTML = history.length
			? history.map((h) =>
			{
					const win = h.payout > 0;
					const voided = h.match_status === "void";
					const score = voided ? "annulé" : `${h.home_score}-${h.away_score}`;
					return `<li class="frow">
						<div class="frow-main">
							<span class="fn">${h.home} ${score} ${h.away}</span>
							<span class="fp">Parié <b>${PICK_LABEL[h.pick]}</b> à ${h.odds}×</span>
						</div>
						<div class="frow-right">
							<span class="fr ${win ? "win" : "lose"}">${win ? "+" + fmt(h.payout) + " pts" : "−" + fmt(h.stake) + " pts"}</span>
							${voided ? `<span class="fmult">remboursé</span>` : ""}
						</div>
					</li>`;
				}).join("")
			: `<li class="empty">Aucun pari réglé.</li>`;
	}

	function renderFootFeed(feed: any[])
	{
		footFeedEl.innerHTML = feed.length
			? feed.map((f) =>
			{
					const av = f.image_url
						? `<img class="fav" src="${f.image_url}" width="28" height="28" alt="" />`
						: `<span class="fav fb">${f.login.charAt(0).toUpperCase()}</span>`;
					const win = f.payout > 0;
					return `<li class="frow">
						${av}
						<div class="frow-main">
							<span class="fn">@${f.login}</span>
							<span class="fp">${f.home} ${f.home_score}-${f.away_score} ${f.away} · parié ${PICK_LABEL[f.pick]} à ${f.odds}×</span>
						</div>
						<span class="fr ${win ? "win" : "lose"}">${win ? "+" + fmt(f.payout) : "−" + fmt(f.stake ?? 0)}</span>
					</li>`;
				}).join("")
			: `<li class="empty">Aucun résultat pour l'instant.</li>`;
	}

	async function refreshFoot()
	{
		const [matches, myBets, feed] = await Promise.all([getFootMatches(), getFootBets(), getFootFeed()]);
		renderMatches(matches, myBets.pending ?? []);
		renderFootHistory(myBets.history ?? []);
		renderFootFeed(feed);
	}

	onExamSettled(() => refresh());
	onFootSettled(() => refreshFoot());
	loadMe().then(() => { void refresh(); void refreshFoot(); });
</script>

