---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="PISCASINO — Paris">
  <Nav />
  <main class="wrap">
    <header class="head">
      <h1>Paris d'exam 🎓</h1>
      <p>
        Prédis ta note au prochain exam 42. Le résultat est récupéré
        automatiquement depuis l'intra — plus tu es précis, plus tu gagnes.
      </p>
    </header>

    <section class="grid">
      <div class="col">
        <div class="bet-card panel" data-betbox>
          <p class="loading">Chargement…</p>
        </div>

        <div class="bareme panel">
          <div class="bt">Barème (écart prédit / réel)</div>
          <div class="br"><span>Exact (±0)</span><b>10×</b></div>
          <div class="br"><span>±6</span><b>3×</b></div>
          <div class="br"><span>±12</span><b>1.5×</b></div>
          <div class="br"><span>±20</span><b>mise rendue</b></div>
          <div class="br dim"><span>au-delà</span><b>perdu</b></div>
        </div>
      </div>

      <div class="col">
        <h2 class="section-title">Derniers résultats</h2>
        <ul class="feed" data-feed><li class="empty">Chargement…</li></ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import {
    loadMe,
    getExamBets,
    getExamFeed,
    placeExamBet,
    onExamSettled,
    fmt,
  } from "../lib/casino";

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const betbox = $("[data-betbox]");
  const feedEl = $("[data-feed]");
  const initial = (n: string) => n.charAt(0).toUpperCase();

  function renderBetbox(data: any) {
    if (data.pending) {
      const p = data.pending;
      betbox.innerHTML = `
        <div class="pending">
          <span class="lbl">Pari en cours</span>
          <div class="pred">${p.predicted}<small>/100</small></div>
          <span class="stake">Mise : ${fmt(p.stake)} pts</span>
          <span class="wait">En attente de ta note d'exam…</span>
        </div>`;
      return;
    }
    betbox.innerHTML = `
      <label class="lbl">Ta prédiction</label>
      <div class="predrow">
        <input class="input" data-pred type="number" min="0" max="100" value="80" />
        <span class="slash">/100</span>
      </div>
      <input class="range" data-range type="range" min="0" max="100" value="80" />
      <label class="lbl">Mise</label>
      <input class="input" data-stake type="number" min="10" value="100" />
      <button class="btn" data-place>Parier</button>
      <p class="err" data-err></p>`;

    const pred = $<HTMLInputElement>("[data-pred]");
    const range = $<HTMLInputElement>("[data-range]");
    range.addEventListener("input", () => (pred.value = range.value));
    pred.addEventListener("input", () => (range.value = pred.value));
    $("[data-place]").addEventListener("click", async () => {
      const err = $("[data-err]");
      err.textContent = "";
      try {
        await placeExamBet(Number(pred.value), Number($<HTMLInputElement>("[data-stake]").value));
        refresh();
      } catch (e: any) {
        err.textContent = e?.message ?? "Erreur";
      }
    });
  }

  function renderFeed(feed: any[]) {
    feedEl.innerHTML = feed.length
      ? feed
          .map((f) => {
            const av = f.image_url
              ? `<img class="fav" src="${f.image_url}" width="28" height="28" alt="" />`
              : `<span class="fav fb">${initial(f.login)}</span>`;
            const win = f.payout > 0;
            return `<li class="frow">
              ${av}
              <span class="fn">${f.display_name || f.login}</span>
              <span class="fp">prédit ${f.predicted} · réel ${f.actual}</span>
              <span class="fr ${win ? "win" : "lose"}">${win ? "+" + fmt(f.payout) : "perdu"}</span>
            </li>`;
          })
          .join("")
      : `<li class="empty">Aucun pari réglé pour l'instant.</li>`;
  }

  async function refresh() {
    const [me, feed] = await Promise.all([getExamBets(), getExamFeed()]);
    renderBetbox(me);
    renderFeed(feed);
  }

  onExamSettled(() => refresh());
  loadMe().then(refresh);
</script>

<style>
  .wrap {
    width: 100%;
    margin: 0 auto;
    max-width: 1100px;
    padding: clamp(20px, 4vw, 40px) clamp(16px, 4vw, 40px);
  }
  .head h1 {
    margin: 0;
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .head p {
    margin: 8px 0 28px;
    color: var(--muted);
    max-width: 640px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .bet-card,
  .bareme {
    padding: 22px;
  }
  .loading {
    color: var(--muted);
  }
  .lbl {
    display: block;
    color: var(--muted);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 14px 0 8px;
  }
  .lbl:first-child {
    margin-top: 0;
  }
  .predrow {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .predrow .input {
    width: 110px;
    font-size: 22px;
    font-weight: 800;
  }
  .slash {
    color: var(--muted);
  }
  .range {
    width: 100%;
    accent-color: var(--accent);
    margin: 6px 0 4px;
  }
  .btn {
    width: 100%;
    margin-top: 16px;
  }
  .err {
    color: var(--lose);
    font-size: 13px;
    min-height: 18px;
    margin: 10px 0 0;
  }
  .pending {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }
  .pred {
    font-size: 64px;
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
  }
  .pred small {
    font-size: 22px;
    color: var(--muted);
  }
  .stake {
    color: var(--muted);
  }
  .wait {
    margin-top: 8px;
    color: var(--muted);
    font-size: 13px;
  }

  .bt {
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }
  .br {
    display: flex;
    justify-content: space-between;
    padding: 5px 0;
    font-size: 14px;
  }
  .br b {
    color: var(--accent);
  }
  .br.dim {
    color: var(--muted);
  }
  .br.dim b {
    color: var(--lose);
  }

  .section-title {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
  }
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .feed :global(.empty) {
    color: var(--muted);
    text-align: center;
    padding: 24px 0;
  }
  .feed :global(.frow) {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
  }
  .feed :global(.fav) {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--raise);
  }
  .feed :global(.fav.fb) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 12px;
    color: #fff;
    background: var(--accent);
  }
  .feed :global(.fn) {
    font-weight: 600;
    font-size: 14px;
  }
  .feed :global(.fp) {
    color: var(--muted);
    font-size: 12px;
    margin-left: auto;
  }
  .feed :global(.fr) {
    font-weight: 800;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .feed :global(.fr.win) {
    color: var(--win);
  }
  .feed :global(.fr.lose) {
    color: var(--lose);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
