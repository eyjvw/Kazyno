---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
---

<Layout title="Kazyno — Dice">
  <Nav />
  <header class="game-header">
    <span class="gh-icon">🎲</span>
    <h1>Dés</h1>
    <span class="gh-sub">· Prédit si le résultat sera au-dessus ou en dessous</span>
    <a class="gh-rules" href="/games/rules/dice" title="Règles">? Règles</a>
  </header>
  <div class="shell">
    <aside class="panel betpanel">
      <div class="field">
        <label>Mise</label>
        <input class="input" data-bet type="number" min="1" value="100" />
        <div class="chips">
          <button data-amt="half">½</button>
          <button data-amt="double">2×</button>
          <button data-amt="max">Max</button>
        </div>
      </div>

      <div class="field">
        <label>Sens</label>
        <div class="seg" data-dir>
          <button data-val="under" class="is-active">Roll Under</button>
          <button data-val="over">Roll Over</button>
        </div>
      </div>

      <div class="field">
        <label>Cible : <b data-tval>50</b></label>
        <input data-target type="range" min="2" max="98" value="50" step="1" />
      </div>

      <div class="stat-row">
        <div class="stat"><span>Multiplicateur</span><b data-mult>1.98×</b></div>
        <div class="stat"><span>Chance</span><b data-chance>50%</b></div>
      </div>

      <button class="btn bet-btn" data-play>Lancer</button>
      <p class="result" data-result></p>
      <div class="sess-stats" data-sess></div>
    </aside>

    <main class="panel stage">
      <div class="roll" data-roll>—</div>
      <div class="track">
        <div class="fill" data-fill></div>
        <div class="marker" data-marker style="left:50%"></div>
        <div class="ball" data-ballx hidden></div>
      </div>
      <div class="scale"><span>0</span><span>50</span><span>100</span></div>
      <div class="hist-bar" data-hist></div>
    </main>
  </div>
</Layout>

<script>
	import { bet, setupAmount, fmt, BetError } from "../../lib/casino";
	import { GameSession } from "../../lib/session";

	const EDGE = 0.99;
	const betInput = document.querySelector<HTMLInputElement>("[data-bet]")!;
	const target = document.querySelector<HTMLInputElement>("[data-target]")!;
	const tval = document.querySelector<HTMLElement>("[data-tval]")!;
	const multEl = document.querySelector<HTMLElement>("[data-mult]")!;
	const chanceEl = document.querySelector<HTMLElement>("[data-chance]")!;
	const result = document.querySelector<HTMLElement>("[data-result]")!;
	const play = document.querySelector<HTMLButtonElement>("[data-play]")!;
	const session = new GameSession(
		document.querySelector("[data-hist]"),
		document.querySelector("[data-sess]"),
	);
	const rollEl = document.querySelector<HTMLElement>("[data-roll]")!;
	const marker = document.querySelector<HTMLElement>("[data-marker]")!;
	const fill = document.querySelector<HTMLElement>("[data-fill]")!;
	const ball = document.querySelector<HTMLElement>("[data-ballx]")!;
	let dir: "under" | "over" = "under";

	setupAmount(betInput);

	function refresh()
	{
		const t = Number(target.value);
		const chance = dir === "under" ? t : 100 - t;
		const mult = (100 / chance) * EDGE;
		tval.textContent = String(t);
		multEl.textContent = mult.toFixed(2) + "×";
		chanceEl.textContent = chance.toFixed(0) + "%";
		marker.style.left = t + "%";
		fill.style.left = dir === "under" ? "0" : t + "%";
		fill.style.right = dir === "under" ? 100 - t + "%" : "0";
	}
	target.addEventListener("input", refresh);
	document.querySelectorAll<HTMLButtonElement>("[data-dir] button").forEach((b) =>
	{
		b.addEventListener("click", () =>
		{
			dir = b.dataset.val as "under" | "over";
			document
				.querySelectorAll("[data-dir] button")
				.forEach((x) => x.classList.toggle("is-active", x === b));
			refresh();
		});
	});
	refresh();

	play.addEventListener("click", async () =>
	{
		play.disabled = true;
		result.textContent = "";
		result.className = "result";
		try
		{
			const r: any = await bet("dice", {
				bet: Number(betInput.value),
				target: Number(target.value),
				direction: dir,
			});
			ball.hidden = false;
			ball.style.left = r.roll + "%";
			ball.style.background = r.win ? "var(--win)" : "var(--lose)";
			rollEl.textContent = r.roll.toFixed(2);
			rollEl.style.color = r.win ? "var(--win)" : "var(--lose)";
			result.textContent = r.win
				? `Gagne +${fmt(r.payout)} pts (${r.multiplier}×)`
				: `Perdu -${fmt(Number(betInput.value))} pts`;
			result.classList.add(r.win ? "win" : "lose");
			session.record(r.win, Number(betInput.value), r.payout);
		}
		catch (e)
		{
			result.textContent = e instanceof BetError ? e.message : "Erreur";
			result.classList.add("lose");
		}
		finally
		{
			play.disabled = false;
		}
	});
</script>

<style>
  .roll {
    font-size: 64px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .track {
    position: relative;
    width: min(560px, 100%);
    height: 14px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .fill {
    position: absolute;
    top: 0;
    bottom: 0;
    background: rgba(59, 130, 246, 0.25);
    border-radius: 10px;
  }
  .marker {
    position: absolute;
    top: -6px;
    bottom: -6px;
    width: 3px;
    background: var(--accent);
    transform: translateX(-50%);
  }
  .ball {
    position: absolute;
    top: 50%;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--win);
    transform: translate(-50%, -50%);
    transition: left 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 0 14px currentColor;
  }
  .scale {
    display: flex;
    justify-content: space-between;
    width: min(560px, 100%);
    color: var(--muted);
    font-size: 12px;
  }
  input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
  }
</style>
