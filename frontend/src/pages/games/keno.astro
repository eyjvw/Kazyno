---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
---

<Layout title="PISCASINO — Keno">
  <Nav />
  <header class="game-header">
    <span class="gh-icon">🔢</span>
    <h1>Keno</h1>
    <span class="gh-sub">· choisis jusqu'à 10 numéros · jusqu'à 100×</span>
  </header>
  <div class="shell">
    <aside class="panel betpanel">
      <div class="field">
        <label>Mise</label>
        <input class="input" data-bet type="number" min="1" value="100" />
        <div class="chips">
          <button data-amt="half">½</button>
          <button data-amt="double">2×</button>
          <button data-amt="max">Max</button>
        </div>
      </div>

      <div class="field">
        <label>Sélection <span data-count>0</span>/10</label>
        <div class="chips">
          <button data-random>🎲 Aléatoire</button>
          <button data-clear>✕ Effacer</button>
        </div>
      </div>

      <div class="field">
        <label>Gains (hits → ×)</label>
        <div class="paytable" data-paytable></div>
      </div>

      <button class="btn bet-btn" data-play disabled>Lancer</button>
      <p class="result" data-result></p>
      <div class="sess-stats" data-sess></div>
    </aside>

    <main class="panel stage keno-stage">
      <div class="keno-grid" data-grid></div>
      <div class="hist-bar" data-hist></div>
    </main>
  </div>
</Layout>

<script>
	import { bet, setupAmount, fmt, BetError } from "../../lib/casino";
	import { GameSession } from "../../lib/session";

	// Même table que le serveur (games.ts KENO_PAYTABLE)
	const PAYTABLE: Record<number, number[]> = {
		1:  [0, 3.96],
		2:  [0, 1.9, 4.5],
		3:  [0, 1, 3.1, 10.4],
		4:  [0, 0.8, 1.8, 5, 22.5],
		5:  [0, 0.25, 1.4, 4.1, 16.5, 36],
		6:  [0, 0, 1, 3.7, 7, 16.5, 40],
		7:  [0, 0, 0.5, 3, 4.5, 14, 31, 60],
		8:  [0, 0, 0, 2.2, 4, 13, 22, 55, 70],
		9:  [0, 0, 0, 1.55, 3, 8, 15, 44, 60, 85],
		10: [0, 0, 0, 1.4, 2.25, 4.5, 8, 17, 50, 80, 100],
	};

	const betInput = document.querySelector<HTMLInputElement>("[data-bet]")!;
	const play     = document.querySelector<HTMLButtonElement>("[data-play]")!;
	const result   = document.querySelector<HTMLElement>("[data-result]")!;
	const gridEl   = document.querySelector<HTMLElement>("[data-grid]")!;
	const countEl  = document.querySelector<HTMLElement>("[data-count]")!;
	const payEl    = document.querySelector<HTMLElement>("[data-paytable]")!;
	const randomBtn = document.querySelector<HTMLButtonElement>("[data-random]")!;
	const clearBtn  = document.querySelector<HTMLButtonElement>("[data-clear]")!;
	const session  = new GameSession(
		document.querySelector("[data-hist]"),
		document.querySelector("[data-sess]"),
	);

	// Mode embed (?embed=1) : chargé dans le modal du lobby → cache nav + header
	if (new URLSearchParams(location.search).has("embed"))
		document.body.classList.add("embed");

	setupAmount(betInput);

	const picked = new Set<number>();
	let playing = false;
	const cells: HTMLButtonElement[] = [];

	for (let n = 1; n <= 40; n++)
	{
		const b = document.createElement("button");
		b.className = "keno-cell";
		b.textContent = String(n);
		b.addEventListener("click", () => toggle(n, b));
		gridEl.appendChild(b);
		cells.push(b);
	}

	function toggle(n: number, b: HTMLButtonElement)
	{
		if (playing) return;
		if (picked.has(n)) { picked.delete(n); b.classList.remove("sel"); }
		else if (picked.size < 10) { picked.add(n); b.classList.add("sel"); }
		refresh();
	}

	function refresh()
	{
		countEl.textContent = String(picked.size);
		play.disabled = picked.size === 0 || playing;
		const row = PAYTABLE[picked.size];
		payEl.innerHTML = row
			? row.map((m, h) => m > 0 ? `<div class="pt-row"><span>${h} hit${h > 1 ? "s" : ""}</span><b>${m}×</b></div>` : "")
				.join("")
			: `<div class="pt-row"><span>Choisis des numéros</span></div>`;
	}

	function clearDraw()
	{
		for (const c of cells) c.classList.remove("hit", "miss", "drawn");
	}

	randomBtn.addEventListener("click", () =>
	{
		if (playing) return;
		picked.clear();
		clearDraw();
		for (const c of cells) c.classList.remove("sel");
		while (picked.size < 10) picked.add(1 + Math.floor(Math.random() * 40));
		for (const n of picked) cells[n - 1].classList.add("sel");
		refresh();
	});

	clearBtn.addEventListener("click", () =>
	{
		if (playing) return;
		picked.clear();
		clearDraw();
		for (const c of cells) c.classList.remove("sel");
		refresh();
	});

	play.addEventListener("click", async () =>
	{
		if (playing || picked.size === 0) return;
		playing = true;
		play.disabled = true;
		result.textContent = "";
		result.className = "result";
		clearDraw();
		const amount = Number(betInput.value);

		try
		{
			const r: any = await bet("keno", { bet: amount, picks: [...picked] });

			// Révèle les tirages un par un
			for (let i = 0; i < r.drawn.length; i++)
			{
				await new Promise((res) => setTimeout(res, 220));
				const cell = cells[r.drawn[i] - 1];
				cell.classList.add(picked.has(r.drawn[i]) ? "hit" : "drawn");
			}
			// Marque les choix ratés
			for (const n of picked)
				if (!r.drawn.includes(n)) cells[n - 1].classList.add("miss");

			result.textContent = r.win
				? `${r.hits} hits · ${r.multiplier}× · +${fmt(r.payout)} pts`
				: `${r.hits} hit${r.hits > 1 ? "s" : ""} · Perdu −${fmt(amount)} pts`;
			result.classList.add(r.win ? "win" : "lose");
			session.record(r.win, amount, r.payout);
		}
		catch (e)
		{
			result.textContent = e instanceof BetError ? e.message : "Erreur";
			result.classList.add("lose");
		}

		playing = false;
		refresh();
	});

	refresh();
</script>

<style is:global>
  /* Mode embed : keno dans le modal du lobby, sans chrome de page */
  body.embed nav,
  body.embed .game-header {
    display: none !important;
  }
  body.embed .shell {
    padding: 12px;
    margin: 0;
    max-width: none;
  }
  body.embed .keno-stage {
    min-height: 0;
  }
</style>

<style>
  .keno-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    min-height: 520px;
  }
  .keno-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 8px;
    width: min(560px, 90vw);
  }
  .keno-grid :global(.keno-cell) {
    aspect-ratio: 1;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--text);
    font-weight: 700;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: transform 0.1s, background 0.15s, border-color 0.15s;
  }
  .keno-grid :global(.keno-cell:hover) {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .keno-grid :global(.keno-cell.sel) {
    background: var(--accent);
    color: #0b0e13;
    border-color: var(--accent);
  }
  .keno-grid :global(.keno-cell.drawn) {
    background: #25313d;
    border-color: #3b82f6;
  }
  .keno-grid :global(.keno-cell.hit) {
    background: var(--win, #22c55e);
    color: #0b0e13;
    border-color: var(--win, #22c55e);
    animation: keno-pop 0.3s;
  }
  .keno-grid :global(.keno-cell.miss) {
    opacity: 0.45;
  }
  @keyframes keno-pop {
    50% { transform: scale(1.18); }
  }
  .paytable {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-height: 180px;
    overflow-y: auto;
  }
  .paytable :global(.pt-row) {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--muted);
  }
  .paytable :global(.pt-row b) {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
</style>
