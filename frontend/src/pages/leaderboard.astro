---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Kazyno — Classement">
  <Nav />
  <main class="wrap">
    <header class="head">
      <h1>Classement</h1>
      <p>Les joueurs les plus riches de Kazyno.</p>
    </header>

    <div class="toolbar">
      <div class="tabs">
        <button class="tab is-active" data-tab="global">💰 Général</button>
        <button class="tab" data-tab="games">🎮 Par jeu</button>
      </div>
      <select class="input game-select" data-game-select hidden></select>
      <input
        class="input search"
        data-search
        type="search"
        placeholder="Rechercher un joueur…"
        autocomplete="off"
      />
    </div>

    <a class="meline" data-meline href="/profile" hidden></a>

    <section data-pane-global>
      <div class="podium" data-podium hidden>
        <div class="step s2" data-podium-2></div>
        <div class="step s1" data-podium-1></div>
        <div class="step s3" data-podium-3></div>
      </div>

      <ol class="list" data-list>
        <li class="empty">Chargement…</li>
      </ol>

      <nav class="pager" data-pager hidden>
        <button class="ghost-btn" data-prev>← Préc.</button>
        <span class="pginfo" data-pginfo></span>
        <button class="ghost-btn" data-next>Suiv. →</button>
      </nav>
    </section>

    <section data-pane-games hidden>
      <div class="podium" data-game-podium hidden>
        <div class="step s2" data-game-podium-2></div>
        <div class="step s1" data-game-podium-1></div>
        <div class="step s3" data-game-podium-3></div>
      </div>

      <ol class="list game-list" data-game-list>
        <li class="empty">Chargement…</li>
      </ol>
    </section>
  </main>
  <Footer />
</Layout>

<script>
	import {
		getLeaderboardPage,
		getGameLeaderboard,
		getMyRank,
		loadMe,
		fmt,
		getBalance,
		onLeaderboard,
		type LeaderRow,
		type GameLeaderRow,
		type Me,
	} from "../lib/casino";

	const PAGE = 20;
	const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
	const list = $("[data-list]");
	const search = $<HTMLInputElement>("[data-search]");
	const pager = $("[data-pager]");
	const pginfo = $("[data-pginfo]");
	const prev = $<HTMLButtonElement>("[data-prev]");
	const next = $<HTMLButtonElement>("[data-next]");
	const podium = $("[data-podium]");
	const meline = $<HTMLAnchorElement>("[data-meline]");
	const paneGlobal = $("[data-pane-global]");
	const paneGames = $("[data-pane-games]");
	const gameSelect = $<HTMLSelectElement>("[data-game-select]");
	const gameList = $("[data-game-list]");
	const gamePodium = $("[data-game-podium]");

	let me: Me | null = null;
	let offset = 0;
	let q = "";
	let total = 0;

	const initial = (n: string) => n.charAt(0).toUpperCase();
	const GRADS = ["rainbow", "fire", "ocean", "galaxy", "toxic"];

	function avatarHtml(r: { image_url: string | null; login: string }, size: number, cls = "av")
	{
		return r.image_url
			? `<img class="${cls}" src="${r.image_url}" width="${size}" height="${size}" alt="" />`
			: `<span class="${cls} fb">${initial(r.login)}</span>`;
	}

	// ── Pinned "my position" line ─────────────────────────────────────────────
	async function renderMeline()
	{
		if (!me) return;
		const rank = await getMyRank();
		if (rank == null) return;
		meline.innerHTML = `
			<span class="ml-rank">#${rank}</span>
			${avatarHtml(me, 28)}
			<span class="ml-name">Ta position</span>
			<span class="ml-pts">${fmt(getBalance())} <em>pts</em></span>`;
		meline.hidden = false;
	}

	// ── Global ranking ────────────────────────────────────────────────────────
	function podiumSlot(r: LeaderRow | undefined, rank: number): string
	{
		if (!r) return "";
		const name = r.display_name || r.login;
		const nc = (r as any).name_color;
		const color = GRADS.includes(nc) ? ` class="grad-${nc}"` : nc ? ` style="color:${nc}"` : "";
		return `
			<a class="pod-user" href="/profile?u=${r.login}">
				<span class="pod-medal pm${rank}">${rank}</span>
				${avatarHtml(r, rank === 1 ? 72 : 56, "pod-av" + (rank === 1 ? " big" : ""))}
				<b${color}>${name}</b>
				<small>@${r.login}</small>
				<span class="pod-pts">${fmt(r.points)} pts</span>
			</a>`;
	}

	function rowHtml(r: LeaderRow)
	{
		const name = r.display_name || r.login;
		const isMe = me && r.login === me.login;
		const rankCls = r.rank <= 3 ? `medal m${r.rank}` : "rank";
		const nc = (r as any).name_color;
		const color = GRADS.includes(nc) ? ` class="grad-${nc}"` : nc ? ` style="color:${nc}"` : "";
		const title = (r as any).title ? `<span class="lb-title">${(r as any).title}</span>` : "";
		return `<li class="row${isMe ? " me" : ""}" data-login="${r.login}">
			<span class="${rankCls}">${r.rank}</span>
			${avatarHtml(r, 28)}
			<a class="name" href="/profile?u=${r.login}"><span${color}>${name}${title}</span><small>@${r.login}</small></a>
			<span class="pts">${fmt(r.points)} <em>pts</em></span>
		</li>`;
	}

	function render(rows: LeaderRow[])
	{
		const showPodium = !q && offset === 0 && rows.length >= 1;
		podium.hidden = !showPodium;
		let listRows = rows;
		if (showPodium)
		{
			([1, 2, 3] as const).forEach((rank) =>
			{
				const slot = $(`[data-podium-${rank}]`);
				slot.innerHTML = podiumSlot(rows[rank - 1], rank);
				slot.classList.toggle("hidden-step", !rows[rank - 1]);
			});
			listRows = rows.slice(3);
		}

		if (!rows.length)
		{
			list.innerHTML = `<li class="empty">Aucun joueur.</li>`;
			pager.hidden = true;
			return;
		}

		// FLIP: remember each visible row's position (keyed by login).
		const prevTop = new Map<string, number>();
		list.querySelectorAll<HTMLElement>(".row").forEach((r) =>
		{
			prevTop.set(r.dataset.login!, r.getBoundingClientRect().top);
		});

		list.innerHTML = listRows.map(rowHtml).join("");

		const items = list.querySelectorAll<HTMLElement>(".row");
		items.forEach((r) =>
		{
			const old = prevTop.get(r.dataset.login!);
			if (old == null) return;
			const delta = old - r.getBoundingClientRect().top;
			if (!delta) return;
			r.style.transition = "none";
			r.style.transform = `translateY(${delta}px)`;
			r.classList.add(delta > 0 ? "moved-up" : "moved-down");
		});
		requestAnimationFrame(() =>
		{
			items.forEach((r) =>
			{
				if (prevTop.get(r.dataset.login!) == null) return;
				r.style.transition = "transform .6s cubic-bezier(.2,.8,.2,1)";
				r.style.transform = "";
			});
		});
		items.forEach((r) =>
			r.addEventListener(
				"animationend",
				() => r.classList.remove("moved-up", "moved-down"),
				{ once: true },
			),
		);

		const from = offset + 1;
		const to = offset + rows.length;
		pginfo.textContent = `${from}–${to} sur ${total}`;
		prev.disabled = offset === 0;
		next.disabled = offset + PAGE >= total;
		pager.hidden = total <= PAGE && offset === 0;
	}

	async function load()
	{
		const data = await getLeaderboardPage(PAGE, offset, q);
		total = data.total;
		render(data.leaderboard);
	}

	let timer: number;
	search.addEventListener("input", () =>
	{
		clearTimeout(timer);
		timer = window.setTimeout(() =>
		{
			q = search.value.trim();
			offset = 0;
			load();
		}, 220);
	});

	prev.addEventListener("click", () =>
	{
		offset = Math.max(0, offset - PAGE);
		load();
	});
	next.addEventListener("click", () =>
	{
		offset += PAGE;
		load();
	});

	let liveTimer: number;
	onLeaderboard(() =>
	{
		clearTimeout(liveTimer);
		liveTimer = window.setTimeout(() =>
		{
			load();
			renderMeline();
		}, 300);
	});

	loadMe().then((m) =>
	{
		me = m;
		load();
		renderMeline();
	});

	// ── Per-game tab ──────────────────────────────────────────────────────────
	const GAMES = [
		{ id: "coinflip",  label: "🪙 Coin Flip" },
		{ id: "dice",      label: "🎲 Dés" },
		{ id: "limbo",     label: "🎯 Limbo" },
		{ id: "plinko",    label: "⚡ Plinko" },
		{ id: "slots",     label: "🎰 Slots" },
		{ id: "roulette",  label: "🎡 Roulette" },
		{ id: "crash",     label: "🚀 Crash" },
		{ id: "mines",     label: "💣 Mines" },
		{ id: "wheel",     label: "🛞 Wheel" },
		{ id: "hilo",      label: "🃏 Hi-Lo" },
		{ id: "tower",     label: "🗼 Tower" },
		{ id: "keno",      label: "🔢 Keno" },
	];

	gameSelect.innerHTML = GAMES.map(g => `<option value="${g.id}">${g.label}</option>`).join("");

	function gameSub(r: GameLeaderRow)
	{
		return `@${r.login} · ${r.games_played} partie${r.games_played > 1 ? "s" : ""}`;
	}

	function gameProfit(r: GameLeaderRow)
	{
		return r.profit >= 0
			? `<span class="pos">+${fmt(r.profit)}</span>`
			: `<span class="neg">${fmt(r.profit)}</span>`;
	}

	function gamePodiumSlot(r: GameLeaderRow | undefined, rank: number): string
	{
		if (!r) return "";
		const name = r.display_name || r.login;
		const nc = (r as any).name_color;
		const color = GRADS.includes(nc) ? ` class="grad-${nc}"` : nc ? ` style="color:${nc}"` : "";
		return `
			<a class="pod-user" href="/profile?u=${r.login}">
				<span class="pod-medal pm${rank}">${rank}</span>
				${avatarHtml(r, rank === 1 ? 72 : 56, "pod-av" + (rank === 1 ? " big" : ""))}
				<b${color}>${name}</b>
				<small>${gameSub(r)}</small>
				<span class="pod-pts">${gameProfit(r)} pts</span>
			</a>`;
	}

	function gameRowHtml(r: GameLeaderRow)
	{
		const name = r.display_name || r.login;
		const isMe = me && r.login === me.login;
		const rankCls = r.rank <= 3 ? `medal m${r.rank}` : "rank";
		const nc = (r as any).name_color;
		const color = GRADS.includes(nc) ? ` class="grad-${nc}"` : nc ? ` style="color:${nc}"` : "";
		return `<li class="row${isMe ? " me" : ""}" data-login="${r.login}">
			<span class="${rankCls}">${r.rank}</span>
			${avatarHtml(r, 28)}
			<a class="name" href="/profile?u=${r.login}"><span${color}>${name}</span><small>${gameSub(r)}</small></a>
			<span class="pts">${gameProfit(r)} <em>pts</em></span>
		</li>`;
	}

	async function loadGame(game: string)
	{
		gamePodium.hidden = true;
		gameList.innerHTML = `<li class="empty">Chargement…</li>`;
		const rows = await getGameLeaderboard(game);
		if (!rows.length)
		{
			gameList.innerHTML = `<li class="empty">Aucune donnée pour ce jeu — sois le premier à jouer !</li>`;
			return;
		}

		// Same clean layout as the global tab: top 3 on the podium, rest below.
		gamePodium.hidden = false;
		([1, 2, 3] as const).forEach((rank) =>
		{
			const slot = $(`[data-game-podium-${rank}]`);
			slot.innerHTML = gamePodiumSlot(rows[rank - 1], rank);
			slot.classList.toggle("hidden-step", !rows[rank - 1]);
		});
		gameList.innerHTML = rows.slice(3).map(gameRowHtml).join("");
	}

	gameSelect.addEventListener("change", () => void loadGame(gameSelect.value));

	// ── Tab switching ─────────────────────────────────────────────────────────
	document.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((tab) =>
	{
		tab.addEventListener("click", () =>
		{
			const isGames = tab.dataset.tab === "games";
			document.querySelectorAll("[data-tab]").forEach((t) =>
				t.classList.toggle("is-active", t === tab));
			paneGlobal.hidden = isGames;
			paneGames.hidden = !isGames;
			search.hidden = isGames;
			gameSelect.hidden = !isGames;
			if (isGames) void loadGame(gameSelect.value);
		});
	});
</script>

<style>
  .wrap {
    max-width: 1000px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 48px) clamp(16px, 4vw, 40px);
  }
  .head h1 {
    margin: 0;
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .head p {
    margin: 8px 0 22px;
    color: var(--muted);
  }

  /* ── Toolbar: tabs + search / game select ── */
  .toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .tabs {
    display: flex;
    gap: 4px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 4px;
    flex: none;
  }
  .tab {
    background: transparent;
    border: none;
    color: var(--muted);
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 7px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .tab:hover { color: var(--fg); }
  .tab.is-active {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .search { flex: 1; min-width: 180px; }
  .game-select {
    flex: 1;
    min-width: 180px;
    cursor: pointer;
  }

  /* ── Pinned my-position line ── */
  .meline {
    display: grid;
    grid-template-columns: 44px 28px 1fr auto;
    align-items: center;
    gap: 12px;
    background: linear-gradient(90deg, rgba(212, 175, 55, 0.1), var(--panel));
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 10px;
    padding: 9px 14px;
    margin-bottom: 14px;
    transition: border-color 0.15s;
  }
  .meline:hover { border-color: var(--accent); }
  .meline[hidden] { display: none !important; }
  .meline :global(.ml-rank) {
    font-weight: 800;
    font-size: 14px;
    color: var(--accent);
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .meline :global(.ml-name) { font-weight: 700; font-size: 14px; }
  .meline :global(.ml-pts) {
    font-weight: 800;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .meline :global(.ml-pts em) {
    color: var(--muted);
    font-style: normal;
    font-weight: 400;
    font-size: 11px;
  }
  .meline :global(.av) {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--raise);
  }
  .meline :global(.av.fb) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 12px;
    color: var(--accent-ink);
    background: var(--accent);
  }

  /* ── Podium ── */
  .podium {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 12px;
    margin-bottom: 18px;
  }
  .step {
    flex: 0 1 220px;
    border-radius: 14px 14px 0 0;
    border: 1px solid var(--line);
    border-bottom: 3px solid var(--accent);
    background: var(--panel);
    padding: 18px 12px 14px;
  }
  .step.s1 {
    padding-top: 26px;
    padding-bottom: 30px;
    background: linear-gradient(180deg, rgba(212, 175, 55, 0.1), var(--panel));
    border-color: rgba(212, 175, 55, 0.35);
    border-bottom-color: var(--accent);
  }
  .step.s2 { border-bottom-color: #cdd6e0; padding-bottom: 20px; }
  .step.s3 { border-bottom-color: #e08b4a; padding-bottom: 10px; }
  .step.hidden-step { display: none; }
  .podium :global(.pod-user) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }
  .podium :global(.pod-medal) {
    font-size: 11px;
    font-weight: 800;
    border-radius: 999px;
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #16281d;
    margin-bottom: 4px;
  }
  .podium :global(.pm1) { background: #ffd24a; }
  .podium :global(.pm2) { background: #cdd6e0; }
  .podium :global(.pm3) { background: #e08b4a; }
  .podium :global(.pod-av) {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--raise);
  }
  .podium :global(.pod-av.big) { width: 72px; height: 72px; }
  .podium :global(.pod-av.fb) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 22px;
    color: var(--accent-ink);
    background: var(--accent);
  }
  .podium :global(.pod-user b) { font-size: 14px; margin-top: 4px; }
  .podium :global(.pod-user small) { color: var(--muted); font-size: 11px; }
  .podium :global(.pod-pts) {
    margin-top: 6px;
    font-weight: 800;
    font-size: 14px;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 640px) {
    .podium { gap: 6px; }
    .step { flex-basis: 150px; padding: 12px 8px 10px; }
    .podium :global(.pod-av) { width: 44px; height: 44px; }
    .podium :global(.pod-av.big) { width: 56px; height: 56px; }
  }

  /* ── Rows (shared global + per-game) ── */
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .list :global(.empty) {
    color: var(--muted);
    text-align: center;
    padding: 40px 0;
  }
  .list :global(.row) {
    display: grid;
    grid-template-columns: 44px 28px 1fr auto;
    align-items: center;
    gap: 12px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 9px 14px;
  }
  .list :global(.row.me) {
    border-color: var(--accent);
    background: var(--panel-2);
  }
  .list :global(.row.moved-up)   { animation: flashUp 0.9s ease; }
  .list :global(.row.moved-down) { animation: flashDown 0.9s ease; }
  .list :global(.rank),
  .list :global(.medal) {
    text-align: center;
    font-weight: 800;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .list :global(.medal) {
    border-radius: 6px;
    padding: 3px 0;
    color: #16281d;
  }
  .list :global(.m1) { background: #ffd24a; }
  .list :global(.m2) { background: #cdd6e0; }
  .list :global(.m3) { background: #e08b4a; }
  .list :global(.av) {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--raise);
  }
  .list :global(.av.fb) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 12px;
    color: var(--accent-ink);
    background: var(--accent);
  }
  .list :global(.name) {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    font-weight: 600;
    font-size: 14px;
    overflow: hidden;
  }
  .list :global(.name small) {
    color: var(--muted);
    font-weight: 400;
    font-size: 11px;
  }
  .list :global(.lb-title) {
    background: rgba(212, 175, 55, 0.14);
    color: var(--accent);
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 10px;
    font-weight: 800;
    margin-left: 7px;
    vertical-align: middle;
    white-space: nowrap;
  }
  .list :global(.pts) {
    font-weight: 800;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .list :global(.pts em) {
    color: var(--muted);
    font-style: normal;
    font-weight: 400;
    font-size: 11px;
  }
  .list :global(.pos) { color: var(--win); }
  .list :global(.neg) { color: var(--lose); }

  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 18px;
  }
  .pager .ghost-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .pginfo {
    color: var(--muted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
</style>
