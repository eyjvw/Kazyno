---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Kazyno — Bienvenue">
  <main class="wrap">
    <div class="panel card" data-first hidden>
      <span class="big">🎰</span>
      <h1>Bienvenue au Kazyno !</h1>
      <p class="lede">Le casino de 42 Le Havre. Avant de flamber, deux-trois trucs à savoir :</p>

      <ul class="points">
        <li><b>💰 1 000 points offerts.</b> Des points, pas des euros — zéro argent réel, zéro achat possible.</li>
        <li><b>🔄 Reset chaque lundi.</b> Tout le monde repart à 1 000 pts, nouvelle course au classement chaque semaine.</li>
        <li><b>🎁 Bonus quotidien.</b> Reviens chaque jour, la streak monte jusqu'à 1 000 pts.</li>
        <li><b>🎓 Paris d'exam.</b> Prédis ta note d'exam, gagne jusqu'à 10× ta mise.</li>
        <li><b>🔒 Provably fair.</b> Chaque tirage est vérifiable cryptographiquement — la maison ne peut pas tricher.</li>
        <li><b>🤝 Fair-play.</b> Pas de scripts, pas d'abus de bugs. Triche = reset du compte.</li>
      </ul>

      <button class="btn go" data-go>C'est parti →</button>
    </div>

    <div class="panel card" data-back hidden>
      <span class="big">👋</span>
      <h1>T'es déjà venu ici :)</h1>
      <p class="lede">Petit rappel du règlement, au cas où :</p>

      <ul class="points">
        <li><b>💰 Points fictifs.</b> Aucune valeur réelle, aucun échange possible.</li>
        <li><b>🔄 Reset hebdo</b> chaque lundi à 1 000 pts.</li>
        <li><b>🔒 Provably fair</b> — vérifie tes tirages depuis ton profil.</li>
        <li><b>🤝 Pas de scripts, pas d'abus de bugs.</b> Triche = reset du compte.</li>
      </ul>

      <a class="btn go" href="/app">Retour au casino →</a>
    </div>
  </main>
  <Footer />
</Layout>

<script>
	import { loadMe } from "../lib/casino";

	loadMe().then((me) =>
	{
		if (!me)
		{
			location.replace("/");
			return;
		}
		const first = document.querySelector<HTMLElement>("[data-first]")!;
		const back = document.querySelector<HTMLElement>("[data-back]")!;
		if (me.welcomed)
		{
			back.hidden = false;
			return;
		}
		first.hidden = false;
		first.querySelector<HTMLButtonElement>("[data-go]")!.addEventListener("click", async () =>
		{
			try { await fetch("/api/auth/welcome", { method: "POST" }); } catch {}
			location.href = "/app";
		});
	});
</script>

<style>
  .wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(24px, 6vw, 64px) clamp(16px, 4vw, 40px);
    flex: 1 0 auto;
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(28px, 5vw, 44px) clamp(20px, 4vw, 40px);
  }
  .card[hidden] { display: none !important; }
  .big { font-size: 52px; line-height: 1; }
  h1 {
    margin: 14px 0 4px;
    font-size: clamp(24px, 4.5vw, 32px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .lede { margin: 0 0 22px; color: var(--muted); font-size: 15px; }
  .points {
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: left;
    width: 100%;
  }
  .points li {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
  }
  .points li b { color: var(--fg); }
  .go { width: 100%; max-width: 320px; }
</style>
