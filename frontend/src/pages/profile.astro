---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="PISCASINO — Profil">
  <Nav />
  <main class="wrap">
    <a class="back" href="/friends">← Retour</a>
    <div data-profile>
      <p class="loading">Chargement…</p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
	import {
		loadMe,
		getProfile,
		sendFriendRequest,
		acceptFriend,
		removeFriend,
		onFriendEvent,
		onPresence,
		loadPresence,
		fmt,
		getAchievements,
		getMyHistory,
		getFairSeeds,
		rotateFairSeeds,
		toast,
		type Profile,
	} from "../lib/casino";

	const host = document.querySelector<HTMLElement>("[data-profile]")!;
	const login = new URLSearchParams(location.search).get("u") ?? "";

	const initial = (n: string) => n.charAt(0).toUpperCase();
	const since = (iso: string) =>
		new Date(iso).toLocaleDateString("fr-FR", {
			day: "numeric",
			month: "long",
			year: "numeric",
		});

	function actionHtml(p: Profile)
	{
		switch (p.status)
		{
			case "self":
				return `<span class="tag">C'est toi</span>`;
			case "friend":
				return `<button class="ghost-btn" data-remove="${p.id}">Retirer des amis</button>`;
			case "pending_out":
				return `<span class="tag">Demande envoyée</span>`;
			case "pending_in":
				return `<button class="btn" data-accept="${p.id}">Accepter la demande</button>`;
			default:
				return `<button class="btn" data-add="${p.login}">Ajouter en ami</button>`;
		}
	}

	async function render(p: Profile)
	{
		const name = p.display_name || p.login;
		const av = p.image_url
			? `<img class="pp" src="${p.image_url}" width="96" height="96" alt="" />`
			: `<span class="pp fb">${initial(name)}</span>`;

		const achievements = await getAchievements(p.login);
		const achHtml = achievements.length
			? `<div class="ach-grid">${achievements.map(a =>
				`<div class="ach-chip" title="${a.desc}">
					<span class="ach-ico">${a.icon}</span>
					<span class="ach-name">${a.name}</span>
				</div>`).join("")}</div>`
			: `<p class="ach-empty">Aucun succès encore.</p>`;

		host.innerHTML = `
			<section class="card">
				<div class="ppwrap">
					${av}<span class="dot ${p.online ? "on" : "off"}"></span>
				</div>
				<h1 class="name">${name}</h1>
				<p class="sub">@${p.login} · ${p.online ? '<span class="ol">en ligne</span>' : "hors ligne"}</p>
				<div class="stats">
					<div class="stat"><span>Solde</span><b>${fmt(p.points)} pts</b></div>
					<div class="stat"><span>Rang</span><b>${p.rank ? "#" + p.rank : "—"}</b></div>
					<div class="stat"><span>Membre depuis</span><b>${since(p.created_at)}</b></div>
				</div>
				<div class="action">${actionHtml(p)}</div>
			</section>
			<section class="ach-section">
				<h2 class="ach-title">Succès <span class="ach-count">${achievements.length}</span></h2>
				${achHtml}
			</section>
			${p.status === "self" ? `
			<section class="ach-section" data-hist-section>
				<h2 class="ach-title">Mes parties <span class="ach-count" data-hist-count>0</span></h2>
				<div class="hist-graph" data-hist-graph></div>
				<div class="hist-rows" data-hist-rows></div>
			</section>
			<section class="ach-section">
				<h2 class="ach-title">Provably fair 🔒</h2>
				<div class="fair-box" data-fair-box><span class="fair-muted">Chargement…</span></div>
			</section>` : ""}`;

		if (p.status === "self")
		{
			void renderHistory();
			void renderFair();
		}
	}

	// ── Personal history + profit sparkline ───────────────────────────────────
	async function renderHistory()
	{
		const rows = await getMyHistory();
		const graphEl = document.querySelector<HTMLElement>("[data-hist-graph]");
		const rowsEl = document.querySelector<HTMLElement>("[data-hist-rows]");
		const countEl = document.querySelector<HTMLElement>("[data-hist-count]");
		if (!graphEl || !rowsEl || !countEl) return;
		countEl.textContent = String(rows.length);
		if (!rows.length)
		{
			graphEl.innerHTML = `<span class="fair-muted">Aucune partie enregistrée.</span>`;
			return;
		}

		// Cumulative profit sparkline (SVG).
		let cum = 0;
		const pts: number[] = rows.map((r: any) => (cum += r.payout - r.bet));
		const min = Math.min(0, ...pts);
		const max = Math.max(0, ...pts);
		const W = 460, H = 90, span = max - min || 1;
		const x = (i: number) => (i / Math.max(1, pts.length - 1)) * W;
		const y = (v: number) => H - ((v - min) / span) * H;
		const path = pts.map((v, i) => `${i === 0 ? "M" : "L"}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
		const zero = y(0);
		const last = pts[pts.length - 1];
		graphEl.innerHTML = `
			<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">
				<line x1="0" y1="${zero}" x2="${W}" y2="${zero}" class="hist-zero" />
				<path d="${path}" class="hist-line ${last >= 0 ? "up" : "down"}" />
			</svg>
			<div class="hist-total ${last >= 0 ? "up" : "down"}">${last >= 0 ? "+" : ""}${fmt(last)} pts sur ${rows.length} parties</div>`;

		rowsEl.innerHTML = rows.slice(-15).reverse().map((r: any) =>
		{
			const profit = r.payout - r.bet;
			return `<div class="hist-row">
				<span class="hist-game">${r.game}</span>
				<span class="hist-bet">${fmt(r.bet)} pts</span>
				<span class="hist-profit ${profit >= 0 ? "up" : "down"}">${profit >= 0 ? "+" : ""}${fmt(profit)}</span>
			</div>`;
		}).join("");
	}

	// ── Provably fair panel ───────────────────────────────────────────────────
	async function renderFair()
	{
		const box = document.querySelector<HTMLElement>("[data-fair-box]");
		if (!box) return;
		const s = await getFairSeeds();
		if (!s)
		{
			box.innerHTML = `<span class="fair-muted">Erreur de chargement.</span>`;
			return;
		}
		box.innerHTML = `
			<p class="fair-muted">Chaque mise dérive son résultat de HMAC-SHA256(server_seed, client_seed:nonce).
			Le hash du seed serveur est publié avant tes mises ; change de seed pour révéler l'ancien et vérifier.</p>
			<div class="fair-row"><span>Hash seed serveur</span><code>${s.server_seed_hash}</code></div>
			<div class="fair-row"><span>Client seed</span><code>${s.client_seed}</code></div>
			<div class="fair-row"><span>Nonce</span><code>${s.nonce}</code></div>
			<button class="btn fair-rotate" data-fair-rotate>Changer de seed (révèle l'ancien)</button>
			<div class="fair-revealed" data-fair-revealed hidden></div>`;
		box.querySelector<HTMLButtonElement>("[data-fair-rotate]")!.addEventListener("click", async (e) =>
		{
			const btn = e.currentTarget as HTMLButtonElement;
			btn.disabled = true;
			try
			{
				const r = await rotateFairSeeds();
				const rev = box.querySelector<HTMLElement>("[data-fair-revealed]")!;
				rev.hidden = false;
				rev.innerHTML = `
					<b>Ancien seed révélé :</b>
					<div class="fair-row"><span>Server seed</span><code>${r.revealed.server_seed}</code></div>
					<div class="fair-row"><span>Client seed</span><code>${r.revealed.client_seed}</code></div>
					<div class="fair-row"><span>Dernier nonce</span><code>${r.revealed.last_nonce}</code></div>`;
				toast("🔒 Nouveau seed généré");
				setTimeout(() => void renderFair(), 4000);
			}
			catch (err: any)
			{
				toast(err?.message ?? "Erreur");
				btn.disabled = false;
			}
		});
	}

	async function load()
	{
		let targetLogin = login;
		if (!targetLogin)
		{
			const me = await loadMe();
			if (!me) { host.innerHTML = `<p class="loading">Non connecté.</p>`; return; }
			targetLogin = me.login;
		}
		const p = await getProfile(targetLogin);
		if (!p)
		{
			host.innerHTML = `<p class="loading">Joueur introuvable.</p>`;
			return;
		}
		render(p);
	}

	document.addEventListener("click", async (e) =>
	{
		const el = e.target as HTMLElement;
		if (el.dataset.add)
		{
			try
			{
				await sendFriendRequest(el.dataset.add);
			} catch {}
			load();
		}
		else if (el.dataset.accept)
		{
			await acceptFriend(Number(el.dataset.accept));
			load();
		}
		else if (el.dataset.remove)
		{
			await removeFriend(Number(el.dataset.remove));
			load();
		}
	});

	onFriendEvent(() => load());
	onPresence(() => load());
	loadPresence();
	load();
</script>

<style>
  .wrap {
    max-width: 540px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 48px) clamp(16px, 4vw, 40px);
  }
  .back {
    color: var(--muted);
    font-size: 13px;
  }
  .back:hover {
    color: var(--fg);
  }
  .loading {
    color: var(--muted);
    text-align: center;
    padding: 60px 0;
  }
  .wrap :global(.card) {
    margin-top: 18px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .wrap :global(.ppwrap) {
    position: relative;
    width: 96px;
    height: 96px;
  }
  .wrap :global(.pp) {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--raise);
  }
  .wrap :global(.pp.fb) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 40px;
    font-weight: 800;
    color: #fff;
    background: var(--accent);
  }
  .wrap :global(.dot) {
    position: absolute;
    right: 4px;
    bottom: 4px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 3px solid var(--panel);
  }
  .wrap :global(.dot.on) {
    background: var(--win);
  }
  .wrap :global(.dot.off) {
    background: var(--muted);
  }
  .wrap :global(.name) {
    margin: 16px 0 2px;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .wrap :global(.sub) {
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 14px;
  }
  .wrap :global(.ol) {
    color: var(--win);
  }
  .wrap :global(.stats) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    width: 100%;
    margin-bottom: 22px;
  }
  .wrap :global(.stat) {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .wrap :global(.stat span) {
    color: var(--muted);
    font-size: 11px;
  }
  .wrap :global(.stat b) {
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .wrap :global(.tag) {
    color: var(--muted);
    font-size: 14px;
    padding: 12px 18px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  /* Achievements */
  .wrap :global(.ach-section) {
    margin-top: 20px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 24px;
  }
  .wrap :global(.ach-title) {
    margin: 0 0 14px;
    font-size: 16px;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .wrap :global(.ach-count) {
    background: var(--raise);
    border-radius: 6px;
    padding: 1px 7px;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
  }
  .wrap :global(.ach-grid) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .wrap :global(.ach-chip) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--raise);
    border: 1px solid var(--line);
    border-radius: 10px;
    cursor: default;
    transition: border-color 0.15s;
  }
  .wrap :global(.ach-chip:hover) { border-color: var(--accent); }
  .wrap :global(.ach-ico)  { font-size: 18px; line-height: 1; }
  .wrap :global(.ach-name) { font-size: 12px; font-weight: 700; }
  /* History */
  .wrap :global(.hist-graph svg) {
    width: 100%;
    height: 90px;
    display: block;
  }
  .wrap :global(.hist-zero) {
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  .wrap :global(.hist-line) {
    fill: none;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .wrap :global(.hist-line.up)   { stroke: #22c55e; }
  .wrap :global(.hist-line.down) { stroke: #ef4444; }
  .wrap :global(.hist-total) {
    font-size: 12px;
    font-weight: 800;
    margin: 8px 0 14px;
    font-variant-numeric: tabular-nums;
  }
  .wrap :global(.hist-total.up)   { color: #22c55e; }
  .wrap :global(.hist-total.down) { color: #ef4444; }
  .wrap :global(.hist-rows) {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .wrap :global(.hist-row) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    background: var(--raise);
    border-radius: 8px;
    font-size: 12px;
  }
  .wrap :global(.hist-game) { font-weight: 700; text-transform: capitalize; flex: 1; text-align: left; }
  .wrap :global(.hist-bet)  { color: var(--muted); font-variant-numeric: tabular-nums; }
  .wrap :global(.hist-profit) { font-weight: 800; font-variant-numeric: tabular-nums; min-width: 70px; text-align: right; }
  .wrap :global(.hist-profit.up)   { color: #22c55e; }
  .wrap :global(.hist-profit.down) { color: #ef4444; }

  /* Provably fair */
  .wrap :global(.fair-muted) {
    color: var(--muted);
    font-size: 12px;
    margin: 0 0 10px;
    line-height: 1.5;
    display: block;
    text-align: left;
  }
  .wrap :global(.fair-row) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 8px;
    text-align: left;
  }
  .wrap :global(.fair-row span) {
    color: var(--muted);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .wrap :global(.fair-row code) {
    font-size: 11px;
    background: var(--raise);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 5px 8px;
    word-break: break-all;
  }
  .wrap :global(.fair-rotate) {
    width: 100%;
    font-size: 13px;
    padding: 10px;
    margin-top: 4px;
  }
  .wrap :global(.fair-revealed) {
    margin-top: 12px;
    padding: 12px;
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: 10px;
    background: rgba(245, 158, 11, 0.06);
    text-align: left;
    font-size: 12px;
  }
  .wrap :global(.fair-revealed b) { display: block; margin-bottom: 8px; }

  .wrap :global(.ach-empty) {
    color: var(--muted);
    font-size: 13px;
    margin: 0;
    text-align: center;
    padding: 12px 0;
  }
</style>
