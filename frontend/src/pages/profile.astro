---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Kazyno — Profil">
  <Nav />
  <main class="wrap">
    <a class="back" href="/friends" data-i18n="profile.back">← Retour</a>
    <div data-profile>
      <p class="loading" data-i18n="profile.loading">Chargement…</p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
	import {
		loadMe,
		getProfile,
		sendFriendRequest,
		acceptFriend,
		removeFriend,
		onFriendEvent,
		onPresence,
		loadPresence,
		fmt,
		getAchievements,
		getMyHistory,
		getFairSeeds,
		rotateFairSeeds,
		getShop,
		equipItem,
		toast,
		type Profile,
	} from "../lib/casino";
	import { t, getLocale, onLocaleChange, type TKey } from "../lib/i18n";

	function applyI18n()
	{
		document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) =>
		{
			el.textContent = t(el.dataset.i18n as TKey);
		});
	}
	applyI18n();
	onLocaleChange(() => { applyI18n(); load(); });

	const host = document.querySelector<HTMLElement>("[data-profile]")!;
	const login = new URLSearchParams(location.search).get("u") ?? "";

	const initial = (n: string) => n.charAt(0).toUpperCase();
	const GRADS = ["rainbow", "fire", "ocean", "galaxy", "toxic"];
	const since = (iso: string) =>
		new Date(iso).toLocaleDateString(getLocale() === "en" ? "en-GB" : "fr-FR", {
			day: "numeric",
			month: "long",
			year: "numeric",
		});

	function actionHtml(p: Profile)
	{
		switch (p.status)
		{
			case "self":
				return "";
			case "friend":
				return `<button class="ghost-btn" data-remove="${p.id}">${t("profile.remove_friend")}</button>`;
			case "pending_out":
				return `<span class="tag">${t("profile.request_sent")}</span>`;
			case "pending_in":
				return `<button class="btn" data-accept="${p.id}">${t("profile.accept")}</button>`;
			default:
				return `<button class="btn" data-add="${p.login}">${t("profile.add_friend")}</button>`;
		}
	}

	async function render(p: Profile)
	{
		const name = p.display_name || p.login;
		const av = p.image_url
			? `<img class="pp" src="${p.image_url}" width="96" height="96" alt="" />`
			: `<span class="pp fb">${initial(name)}</span>`;

		const achievements = await getAchievements(p.login);
		const achHtml = achievements.length
			? `<div class="ach-grid">${achievements.map(a =>
				`<div class="ach-chip" title="${a.desc}">
					<span class="ach-ico">${a.icon}</span>
					<span class="ach-name">${a.name}</span>
				</div>`).join("")}</div>`
			: `<p class="ach-empty">${t("profile.no_achievements")}</p>`;

		host.innerHTML = `
			<div class="layout">
				<aside class="sidebar">
					<section class="card">
						<div class="ppwrap">
							${av}<span class="dot ${p.online ? "on" : "off"}"></span>
						</div>
						<h1 class="name${GRADS.includes(p.name_color ?? "") ? ` grad-${p.name_color}` : ""}"${p.name_color && !GRADS.includes(p.name_color) ? ` style="color:${p.name_color}"` : ""}>${name}</h1>
						${p.title ? `<p class="title-tag">${p.title}</p>` : ""}
						<p class="sub">@${p.login} · ${p.online ? `<span class="ol">${t("profile.online")}</span>` : t("profile.offline")}</p>
						<div class="stats">
							<div class="stat"><span>${t("profile.balance")}</span><b>${fmt(p.points)} pts</b></div>
							<div class="stat"><span>${t("profile.rank")}</span><b>${p.rank ? "#" + p.rank : "—"}</b></div>
							<div class="stat"><span>${t("profile.member_since")}</span><b>${since(p.created_at)}</b></div>
						</div>
						<div class="action">${actionHtml(p)}</div>
					</section>
					${p.status === "self" ? `
					<section class="card title-card" data-title-section hidden>
						<h2 class="ach-title">${t("profile.title_section")}</h2>
						<div class="title-picker" data-title-picker></div>
					</section>
					<a class="settings-link" href="/settings">${t("profile.settings_link")} →</a>` : ""}
				</aside>
				<div class="main-col">
					<section class="ach-section">
						<h2 class="ach-title">${t("profile.achievements")} <span class="ach-count">${achievements.length}</span></h2>
						${achHtml}
					</section>
					${p.status === "self" ? `
					<section class="ach-section" data-hist-section>
						<h2 class="ach-title">${t("profile.my_games")} <span class="ach-count" data-hist-count>0</span></h2>
						<div class="hist-graph" data-hist-graph></div>
						<div class="hist-rows" data-hist-rows></div>
					</section>
					<section class="ach-section">
						<h2 class="ach-title">${t("profile.fair_title")} <a class="info-btn" href="/legal/fair" title="${t("profile.fair_help")}">?</a></h2>
						<div class="fair-box" data-fair-box><span class="fair-muted">${t("profile.loading")}</span></div>
					</section>` : ""}
				</div>
			</div>`;

		if (p.status === "self")
		{
			void renderHistory();
			void renderFair();
			void renderTitlePicker();
		}
	}

	// ── Title picker (owned cosmetic titles from the shop) ────────────────────
	async function renderTitlePicker()
	{
		const section = document.querySelector<HTMLElement>("[data-title-section]");
		const picker  = document.querySelector<HTMLElement>("[data-title-picker]");
		if (!section || !picker) return;

		const { items, owned, equipped } = await getShop();
		const titles = items.filter((i: any) => i.kind === "title" && owned.includes(i.key));
		if (!titles.length)
		{
			section.hidden = true;
			return;
		}
		section.hidden = false;

		const options = [{ key: null, label: t("profile.no_title"), value: null }, ...titles];
		picker.innerHTML = options.map((o: any) => `
			<button class="title-opt ${equipped?.title === o.value ? "is-active" : ""}" data-title-key="${o.key ?? ""}">
				${o.label ?? o.value}
			</button>
		`).join("");

		picker.querySelectorAll<HTMLButtonElement>("[data-title-key]").forEach((btn) =>
		{
			btn.addEventListener("click", async () =>
			{
				const key = btn.dataset.titleKey || null;
				try
				{
					await equipItem(key, key ? undefined : "title");
					await load();
				}
				catch (e: any)
				{
					toast(e?.message ?? "Erreur");
				}
			});
		});
	}

	// ── Personal history + profit sparkline ───────────────────────────────────
	async function renderHistory()
	{
		const rows = await getMyHistory();
		const graphEl = document.querySelector<HTMLElement>("[data-hist-graph]");
		const rowsEl = document.querySelector<HTMLElement>("[data-hist-rows]");
		const countEl = document.querySelector<HTMLElement>("[data-hist-count]");
		if (!graphEl || !rowsEl || !countEl) return;
		countEl.textContent = String(rows.length);
		if (!rows.length)
		{
			graphEl.innerHTML = `<span class="fair-muted">${t("profile.no_games")}</span>`;
			return;
		}

		// Cumulative profit sparkline (SVG).
		let cum = 0;
		const pts: number[] = rows.map((r: any) => (cum += r.payout - r.bet));
		const min = Math.min(0, ...pts);
		const max = Math.max(0, ...pts);
		const W = 460, H = 90, span = max - min || 1;
		const x = (i: number) => (i / Math.max(1, pts.length - 1)) * W;
		const y = (v: number) => H - ((v - min) / span) * H;
		const path = pts.map((v, i) => `${i === 0 ? "M" : "L"}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
		const zero = y(0);
		const last = pts[pts.length - 1];
		graphEl.innerHTML = `
			<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">
				<line x1="0" y1="${zero}" x2="${W}" y2="${zero}" class="hist-zero" />
				<path d="${path}" class="hist-line ${last >= 0 ? "up" : "down"}" />
			</svg>
			<div class="hist-total ${last >= 0 ? "up" : "down"}">${last >= 0 ? "+" : ""}${fmt(last)} pts ${t("profile.games_profit", { n: rows.length })}</div>`;

		rowsEl.innerHTML = rows.slice(-15).reverse().map((r: any) =>
		{
			const profit = r.payout - r.bet;
			return `<div class="hist-row">
				<span class="hist-game">${r.game}</span>
				<span class="hist-bet">${fmt(r.bet)} pts</span>
				<span class="hist-profit ${profit >= 0 ? "up" : "down"}">${profit >= 0 ? "+" : ""}${fmt(profit)}</span>
			</div>`;
		}).join("");
	}

	// ── Provably fair panel ───────────────────────────────────────────────────
	async function renderFair()
	{
		const box = document.querySelector<HTMLElement>("[data-fair-box]");
		if (!box) return;
		const s = await getFairSeeds();
		if (!s)
		{
			box.innerHTML = `<span class="fair-muted">Erreur de chargement.</span>`;
			return;
		}
		box.innerHTML = `
			<p class="fair-muted">Chaque mise dérive son résultat de HMAC-SHA256(server_seed, client_seed:nonce).
			Le hash du seed serveur est publié avant tes mises ; change de seed pour révéler l'ancien et vérifier.</p>
			<div class="fair-row"><span>Hash seed serveur</span><code>${s.server_seed_hash}</code></div>
			<div class="fair-row"><span>Client seed</span><code>${s.client_seed}</code></div>
			<div class="fair-row"><span>Nonce</span><code>${s.nonce}</code></div>
			<button class="btn fair-rotate" data-fair-rotate>Changer de seed (révèle l'ancien)</button>
			<div class="fair-revealed" data-fair-revealed hidden></div>`;
		box.querySelector<HTMLButtonElement>("[data-fair-rotate]")!.addEventListener("click", async (e) =>
		{
			const btn = e.currentTarget as HTMLButtonElement;
			btn.disabled = true;
			try
			{
				const r = await rotateFairSeeds();
				const rev = box.querySelector<HTMLElement>("[data-fair-revealed]")!;
				rev.hidden = false;
				rev.innerHTML = `
					<b>Ancien seed révélé :</b>
					<div class="fair-row"><span>Server seed</span><code>${r.revealed.server_seed}</code></div>
					<div class="fair-row"><span>Client seed</span><code>${r.revealed.client_seed}</code></div>
					<div class="fair-row"><span>Dernier nonce</span><code>${r.revealed.last_nonce}</code></div>`;
				toast("🔒 Nouveau seed généré");
				setTimeout(() => void renderFair(), 4000);
			}
			catch (err: any)
			{
				toast(err?.message ?? "Erreur");
				btn.disabled = false;
			}
		});
	}

	async function load()
	{
		let targetLogin = login;
		if (!targetLogin)
		{
			const me = await loadMe();
			if (!me) { host.innerHTML = `<p class="loading">${t("profile.not_logged")}</p>`; return; }
			targetLogin = me.login;
		}
		const p = await getProfile(targetLogin);
		if (!p)
		{
			host.innerHTML = `<p class="loading">${t("profile.not_found")}</p>`;
			return;
		}
		render(p);
	}

	document.addEventListener("click", async (e) =>
	{
		const el = e.target as HTMLElement;
		if (el.dataset.add)
		{
			try
			{
				await sendFriendRequest(el.dataset.add);
			} catch {}
			load();
		}
		else if (el.dataset.accept)
		{
			await acceptFriend(Number(el.dataset.accept));
			load();
		}
		else if (el.dataset.remove)
		{
			await removeFriend(Number(el.dataset.remove));
			load();
		}
	});

	onFriendEvent(() => load());
	onPresence(() => load());
	loadPresence();
	load();
</script>

<style>
  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 48px) clamp(16px, 4vw, 40px);
  }
  .wrap :global(.layout) {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 18px;
    align-items: start;
    margin-top: 18px;
  }
  .wrap :global(.sidebar) {
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: sticky;
    top: 18px;
  }
  .wrap :global(.main-col) {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  @media (max-width: 820px) {
    .wrap :global(.layout) { grid-template-columns: 1fr; }
    .wrap :global(.sidebar) { position: static; }
  }
  .back {
    color: var(--muted);
    font-size: 13px;
  }
  .back:hover {
    color: var(--fg);
  }
  .loading {
    color: var(--muted);
    text-align: center;
    padding: 60px 0;
  }
  .wrap :global(.card) {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .wrap :global(.ppwrap) {
    position: relative;
    width: 96px;
    height: 96px;
  }
  .wrap :global(.pp) {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--raise);
  }
  .wrap :global(.pp.fb) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 40px;
    font-weight: 800;
    color: #fff;
    background: var(--accent);
  }
  .wrap :global(.dot) {
    position: absolute;
    right: 4px;
    bottom: 4px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 3px solid var(--panel);
  }
  .wrap :global(.dot.on) {
    background: var(--win);
  }
  .wrap :global(.dot.off) {
    background: var(--muted);
  }
  .wrap :global(.name) {
    margin: 16px 0 2px;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .wrap :global(.sub) {
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 14px;
  }
  .wrap :global(.ol) {
    color: var(--win);
  }
  .wrap :global(.stats) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    width: 100%;
    margin-bottom: 22px;
  }
  .wrap :global(.stat) {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .wrap :global(.stat span) {
    color: var(--muted);
    font-size: 11px;
  }
  .wrap :global(.stat b) {
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .wrap :global(.tag) {
    color: var(--muted);
    font-size: 14px;
    padding: 12px 18px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  /* Achievements */
  .wrap :global(.ach-section) {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 24px;
  }
  .wrap :global(.ach-title) {
    margin: 0 0 14px;
    font-size: 16px;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .wrap :global(.info-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--raise);
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
    margin-left: 2px;
    transition: background 0.15s, color 0.15s;
  }
  .wrap :global(.info-btn:hover) { background: var(--accent); color: var(--accent-ink); }
  .wrap :global(.ach-count) {
    background: var(--raise);
    border-radius: 6px;
    padding: 1px 7px;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
  }
  .wrap :global(.ach-grid) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .wrap :global(.ach-chip) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--raise);
    border: 1px solid var(--line);
    border-radius: 10px;
    cursor: default;
    transition: border-color 0.15s;
  }
  .wrap :global(.ach-chip:hover) { border-color: var(--accent); }
  .wrap :global(.ach-ico)  { font-size: 18px; line-height: 1; }
  .wrap :global(.ach-name) { font-size: 12px; font-weight: 700; }
  /* History */
  .wrap :global(.hist-graph svg) {
    width: 100%;
    height: 90px;
    display: block;
  }
  .wrap :global(.hist-zero) {
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  .wrap :global(.hist-line) {
    fill: none;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .wrap :global(.hist-line.up)   { stroke: #22c55e; }
  .wrap :global(.hist-line.down) { stroke: #ef4444; }
  .wrap :global(.hist-total) {
    font-size: 12px;
    font-weight: 800;
    margin: 8px 0 14px;
    font-variant-numeric: tabular-nums;
  }
  .wrap :global(.hist-total.up)   { color: #22c55e; }
  .wrap :global(.hist-total.down) { color: #ef4444; }
  .wrap :global(.hist-rows) {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .wrap :global(.hist-row) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    background: var(--raise);
    border-radius: 8px;
    font-size: 12px;
  }
  .wrap :global(.hist-game) { font-weight: 700; text-transform: capitalize; flex: 1; text-align: left; }
  .wrap :global(.hist-bet)  { color: var(--muted); font-variant-numeric: tabular-nums; }
  .wrap :global(.hist-profit) { font-weight: 800; font-variant-numeric: tabular-nums; min-width: 70px; text-align: right; }
  .wrap :global(.hist-profit.up)   { color: #22c55e; }
  .wrap :global(.hist-profit.down) { color: #ef4444; }

  /* Provably fair */
  .wrap :global(.fair-muted) {
    color: var(--muted);
    font-size: 12px;
    margin: 0 0 10px;
    line-height: 1.5;
    display: block;
    text-align: left;
  }
  .wrap :global(.fair-row) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 8px;
    text-align: left;
  }
  .wrap :global(.fair-row span) {
    color: var(--muted);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .wrap :global(.fair-row code) {
    font-size: 11px;
    background: var(--raise);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 5px 8px;
    word-break: break-all;
  }
  .wrap :global(.fair-rotate) {
    width: 100%;
    font-size: 13px;
    padding: 10px;
    margin-top: 4px;
  }
  .wrap :global(.fair-revealed) {
    margin-top: 12px;
    padding: 12px;
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: 10px;
    background: rgba(245, 158, 11, 0.06);
    text-align: left;
    font-size: 12px;
  }
  .wrap :global(.fair-revealed b) { display: block; margin-bottom: 8px; }

  .wrap :global(.ach-empty) {
    color: var(--muted);
    font-size: 13px;
    margin: 0;
    text-align: center;
    padding: 12px 0;
  }

  /* Title tag + picker */
  .wrap :global(.title-tag) {
    margin: 0 0 8px;
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 20px;
    padding: 3px 12px;
  }
  .wrap :global(.title-card) { padding: 20px; }
  .wrap :global(.title-picker) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 220px;
    overflow-y: auto;
    padding-right: 4px;
  }
  .wrap :global(.title-picker::-webkit-scrollbar) { width: 6px; }
  .wrap :global(.title-picker::-webkit-scrollbar-thumb) {
    background: var(--raise);
    border-radius: 3px;
  }
  .wrap :global(.title-opt) {
    background: var(--raise);
    border: 1px solid var(--line);
    color: var(--muted);
    border-radius: 8px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 12px;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .wrap :global(.title-opt:hover) { color: var(--fg); border-color: var(--accent); }
  .wrap :global(.title-opt.is-active) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .wrap :global(.settings-link) {
    display: block;
    text-align: center;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    padding: 4px 0;
  }
  .wrap :global(.settings-link:hover) { color: var(--accent); }
</style>
