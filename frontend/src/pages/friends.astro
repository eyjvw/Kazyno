---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="PISCASINO — Amis">
  <Nav />
  <main class="wrap">
    <header class="head">
      <h1>Amis</h1>
      <p>Cherche des joueurs, ajoute-les, vois qui est en ligne.</p>
    </header>

    <div class="search">
      <input
        class="input"
        data-search
        type="search"
        placeholder="Rechercher un joueur (login ou nom)…"
        autocomplete="off"
      />
      <ul class="list results" data-results hidden></ul>
    </div>

    <div class="tabs">
      <button class="tab is-active" data-tab="friends">
        Amis <span class="count" data-c-friends>0</span>
      </button>
      <button class="tab" data-tab="requests">
        Demandes <span class="count" data-c-requests>0</span>
      </button>
      <button class="tab" data-tab="duels">
        Duels ⚔️ <span class="count" data-c-duels>0</span>
      </button>
    </div>

    <section data-pane="friends">
      <ul class="list" data-friends><li class="empty">Chargement…</li></ul>
    </section>

    <section data-pane="requests" hidden>
      <ul class="list" data-requests><li class="empty">Aucune demande.</li></ul>
    </section>

    <section data-pane="duels" hidden>
      <ul class="list" data-duels><li class="empty">Aucun duel. Défie un ami ⚔️</li></ul>
    </section>
  </main>

  <!-- Duel modal -->
  <div class="gift-modal" data-duel-modal hidden>
    <div class="gift-card">
      <button class="gift-close" data-duel-close>✕</button>
      <div class="gift-icon">⚔️</div>
      <h2 class="gift-title">Duel coinflip</h2>
      <p class="gift-to" data-duel-to></p>
      <div class="field" style="width:100%">
        <label>Mise (chacun)</label>
        <input class="input" data-duel-stake type="number" min="10" max="100000" value="100" />
      </div>
      <button class="btn" data-duel-send style="width:100%">Défier ⚔️</button>
      <p class="gift-err" data-duel-err hidden></p>
    </div>
  </div>

  <!-- Gift modal -->
  <div class="gift-modal" data-gift-modal hidden>
    <div class="gift-card">
      <button class="gift-close" data-gift-close>✕</button>
      <div class="gift-icon">🎁</div>
      <h2 class="gift-title">Offrir des points</h2>
      <p class="gift-to" data-gift-to></p>
      <div class="field" style="width:100%">
        <label>Montant</label>
        <input class="input" data-gift-amount type="number" min="1" max="100000" value="100" />
      </div>
      <button class="btn" data-gift-send style="width:100%">Envoyer 🎁</button>
      <p class="gift-err" data-gift-err hidden></p>
    </div>
  </div>

  <Footer />
</Layout>

<script>
	import {
		getFriends,
		getRequests,
		searchUsers,
		sendFriendRequest,
		acceptFriend,
		declineFriend,
		cancelFriend,
		removeFriend,
		giftPoints,
		getMyDuels,
		challengeDuel,
		acceptDuel,
		declineDuel,
		cancelDuel,
		onDuel,
		getMyId,
		toast,
		onFriendEvent,
		onPresence,
		loadPresence,
		fmt,
		type FriendCard,
		type RequestsData,
		type SearchResult,
	} from "../lib/casino";

	const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
	const friendsEl = $("[data-friends]");
	const requestsEl = $("[data-requests]");
	const resultsEl = $("[data-results]");
	const searchInput = $<HTMLInputElement>("[data-search]");
	const cFriends = $("[data-c-friends]");
	const cRequests = $("[data-c-requests]");

	const initial = (n: string) => n.charAt(0).toUpperCase();
	const avatar = (u: { image_url: string | null; login: string }) =>
		u.image_url
			? `<img class="av" src="${u.image_url}" width="36" height="36" alt="" />`
			: `<span class="av fb">${initial(u.login)}</span>`;
	const dot = (online?: boolean) =>
		`<span class="pres ${online ? "on" : "off"}" title="${online ? "en ligne" : "hors ligne"}"></span>`;

	// ── Friends + requests ──────────────────────────────────────────────
	function renderFriends(list: FriendCard[])
	{
		cFriends.textContent = String(list.length);
		friendsEl.innerHTML = list.length
			? list
					.map(
						(f) => `<li class="row">
							<a class="avwrap" href="/profile?u=${f.login}">${avatar(f)}${dot(f.online)}</a>
							<a class="name" href="/profile?u=${f.login}">${f.display_name || f.login}<small>@${f.login}</small></a>
							<span class="pts">${fmt(f.points ?? 0)} pts</span>
							<button class="gift-btn sm" data-duel-open="${f.login}" title="Défier en duel">⚔️</button>
							<button class="gift-btn sm" data-gift="${f.login}" title="Offrir des points">🎁</button>
							<button class="ghost-btn sm" data-remove="${f.id}">Retirer</button>
						</li>`,
					)
					.join("")
			: `<li class="empty">Aucun ami. Cherche quelqu'un ci-dessus 👆</li>`;
	}

	function renderRequests(data: RequestsData)
	{
		const { incoming, outgoing } = data;
		cRequests.textContent = String(incoming.length + outgoing.length);

		if (!incoming.length && !outgoing.length)
		{
			requestsEl.innerHTML = `<li class="empty">Aucune demande.</li>`;
			return;
		}

		const inHtml = incoming
			.map(
				(u) => `<li class="row">
					<a class="avwrap" href="/profile?u=${u.login}">${avatar(u)}</a>
					<a class="name" href="/profile?u=${u.login}">${u.display_name || u.login}<small>@${u.login}</small></a>
					<button class="btn sm" data-accept="${u.id}">Accepter</button>
					<button class="ghost-btn sm" data-decline="${u.id}">Refuser</button>
				</li>`,
			)
			.join("");

		const outHtml = outgoing
			.map(
				(u) => `<li class="row">
					<a class="avwrap" href="/profile?u=${u.login}">${avatar(u)}</a>
					<a class="name" href="/profile?u=${u.login}">${u.display_name || u.login}<small>@${u.login}</small></a>
					<span class="tag">En attente</span>
					<button class="ghost-btn sm" data-cancel="${u.id}">Annuler</button>
				</li>`,
			)
			.join("");

		requestsEl.innerHTML =
			(incoming.length ? `<li class="subhead">Reçues</li>${inHtml}` : "") +
			(outgoing.length ? `<li class="subhead">Envoyées</li>${outHtml}` : "");
	}

	async function refresh()
	{
		const [friends, requests] = await Promise.all([getFriends(), getRequests()]);
		renderFriends(friends);
		renderRequests(requests);
		void refreshDuels();
	}

	// ── Duels ───────────────────────────────────────────────────────────
	const duelsEl = $("[data-duels]");
	const cDuels = $("[data-c-duels]");

	function duelRow(d: any): string
	{
		const me = getMyId();
		const iAmChallenger = d.challenger_id === me;
		const other = iAmChallenger
			? { login: d.opponent_login, name: d.opponent_name, image_url: d.opponent_image }
			: { login: d.challenger_login, name: d.challenger_name, image_url: d.challenger_image };
		const av = avatar({ image_url: other.image_url, login: other.login });

		let action = "";
		if (d.status === "pending")
		{
			action = iAmChallenger
				? `<span class="tag">En attente</span><button class="ghost-btn sm" data-duel-cancel="${d.id}">Annuler</button>`
				: `<button class="btn sm" data-duel-accept="${d.id}">Accepter ⚔️</button><button class="ghost-btn sm" data-duel-decline="${d.id}">Refuser</button>`;
		}
		else if (d.status === "resolved")
		{
			const won = d.winner_id === me;
			action = `<span class="tag ${won ? "ok" : ""}">${won ? `Gagné +${fmt(d.stake)}` : `Perdu -${fmt(d.stake)}`}</span>`;
		}
		else
		{
			action = `<span class="tag">${d.status === "declined" ? "Refusé" : "Annulé"}</span>`;
		}

		return `<li class="row">
			<a class="avwrap" href="/profile?u=${other.login}">${av}</a>
			<a class="name" href="/profile?u=${other.login}">${other.name || other.login}<small>⚔️ ${fmt(d.stake)} pts</small></a>
			${action}
		</li>`;
	}

	async function refreshDuels()
	{
		const duels = await getMyDuels();
		const me = getMyId();
		const pendingIn = duels.filter((d: any) => d.status === "pending" && d.opponent_id === me).length;
		cDuels.textContent = String(pendingIn);
		duelsEl.innerHTML = duels.length
			? duels.map(duelRow).join("")
			: `<li class="empty">Aucun duel. Défie un ami ⚔️</li>`;
	}

	// ── Search ──────────────────────────────────────────────────────────
	const actionFor = (r: SearchResult) =>
	{
		switch (r.status)
		{
			case "friend":
				return `<span class="tag ok">Ami ✓</span>`;
			case "pending_out":
				return `<span class="tag">En attente</span>`;
			case "pending_in":
				return `<button class="btn sm" data-accept="${r.id}">Accepter</button>`;
			default:
				return `<button class="btn sm" data-add="${r.id}" data-login="${r.login}">Ajouter</button>`;
		}
	};

	function renderResults(list: SearchResult[])
	{
		if (!list.length)
		{
			resultsEl.innerHTML = `<li class="empty sm">Aucun résultat.</li>`;
			resultsEl.hidden = false;
			return;
		}
		resultsEl.innerHTML = list
			.map(
				(r) => `<li class="row">
					<a class="avwrap" href="/profile?u=${r.login}">${avatar(r)}${dot(r.online)}</a>
					<a class="name" href="/profile?u=${r.login}">${r.display_name || r.login}<small>@${r.login}</small></a>
					${actionFor(r)}
				</li>`,
			)
			.join("");
		resultsEl.hidden = false;
	}

	let timer: number;
	searchInput.addEventListener("input", () =>
	{
		clearTimeout(timer);
		const q = searchInput.value.trim();
		if (!q)
		{
			resultsEl.hidden = true;
			resultsEl.innerHTML = "";
			return;
		}
		timer = window.setTimeout(async () =>
		{
			renderResults(await searchUsers(q));
		}, 220);
	});

	async function rerunSearch()
	{
		const q = searchInput.value.trim();
		if (q) renderResults(await searchUsers(q));
	}

	// ── Actions (delegation, works for both lists + results) ────────────
	document.addEventListener("click", async (e) =>
	{
		const el = e.target as HTMLElement;
		if (el.dataset.duelOpen)
		{
			duelTarget = el.dataset.duelOpen;
			duelToEl.textContent = `Contre @${duelTarget} — le gagnant rafle tout`;
			duelStakeEl.value = "100";
			duelErrEl.hidden = true;
			duelModal.hidden = false;
		}
		else if (el.dataset.duelAccept)
		{
			(el as HTMLButtonElement).disabled = true;
			try
			{
				const r = await acceptDuel(Number(el.dataset.duelAccept));
				toast(r.win ? `⚔️ Duel gagné ! +${fmt(r.pot)} pts` : "⚔️ Duel perdu…");
			}
			catch (err: any) { toast(err?.message ?? "Erreur"); }
			void refreshDuels();
		}
		else if (el.dataset.duelDecline)
		{
			await declineDuel(Number(el.dataset.duelDecline)).catch(() => {});
			void refreshDuels();
		}
		else if (el.dataset.duelCancel)
		{
			await cancelDuel(Number(el.dataset.duelCancel)).catch(() => {});
			void refreshDuels();
		}
		else if (el.dataset.gift)
		{
			giftTarget = el.dataset.gift;
			giftToEl.textContent = `Pour @${giftTarget}`;
			giftAmtEl.value = "100";
			giftErrEl.hidden = true;
			giftModal.hidden = false;
		}
		else if (el.dataset.add)
		{
			try
			{
				await sendFriendRequest(el.dataset.login!);
			} catch {}
			await Promise.all([refresh(), rerunSearch()]);
		}
		else if (el.dataset.accept)
		{
			await acceptFriend(Number(el.dataset.accept));
			await Promise.all([refresh(), rerunSearch()]);
		}

		else if (el.dataset.decline)
		{
			await declineFriend(Number(el.dataset.decline));
			refresh();
		}
		else if (el.dataset.cancel)
		{
			await cancelFriend(Number(el.dataset.cancel));
			await Promise.all([refresh(), rerunSearch()]);
		}
		else if (el.dataset.remove)
		{
			await removeFriend(Number(el.dataset.remove));
			await Promise.all([refresh(), rerunSearch()]);
		}
	});

	// ── Gift modal ───────────────────────────────────────────────────────────
	const giftModal   = document.querySelector<HTMLElement>("[data-gift-modal]")!;
	const giftToEl    = document.querySelector<HTMLElement>("[data-gift-to]")!;
	const giftAmtEl   = document.querySelector<HTMLInputElement>("[data-gift-amount]")!;
	const giftSendBtn = document.querySelector<HTMLButtonElement>("[data-gift-send]")!;
	const giftErrEl   = document.querySelector<HTMLElement>("[data-gift-err]")!;
	let giftTarget    = "";

	document.querySelector("[data-gift-close]")?.addEventListener("click", () => { giftModal.hidden = true; });
	giftModal.addEventListener("click", (e) => { if (e.target === giftModal) giftModal.hidden = true; });

	giftSendBtn.addEventListener("click", async () =>
	{
		const amount = Math.floor(Number(giftAmtEl.value));
		if (!amount || amount < 1)
		{
			giftErrEl.textContent = "Montant invalide (min 1 pt)";
			giftErrEl.hidden = false;
			return;
		}
		giftSendBtn.disabled = true;
		giftErrEl.hidden = true;
		try
		{
			await giftPoints(giftTarget, amount);
			giftModal.hidden = true;
			void refresh();
		}
		catch (e: any)
		{
			giftErrEl.textContent = e.message ?? "Erreur";
			giftErrEl.hidden = false;
		}
		finally { giftSendBtn.disabled = false; }
	});

	// ── Duel modal ───────────────────────────────────────────────────────────
	const duelModal   = document.querySelector<HTMLElement>("[data-duel-modal]")!;
	const duelToEl    = document.querySelector<HTMLElement>("[data-duel-to]")!;
	const duelStakeEl = document.querySelector<HTMLInputElement>("[data-duel-stake]")!;
	const duelSendBtn = document.querySelector<HTMLButtonElement>("[data-duel-send]")!;
	const duelErrEl   = document.querySelector<HTMLElement>("[data-duel-err]")!;
	let duelTarget    = "";

	document.querySelector("[data-duel-close]")?.addEventListener("click", () => { duelModal.hidden = true; });
	duelModal.addEventListener("click", (e) => { if (e.target === duelModal) duelModal.hidden = true; });

	duelSendBtn.addEventListener("click", async () =>
	{
		const stake = Math.floor(Number(duelStakeEl.value));
		if (!stake || stake < 10)
		{
			duelErrEl.textContent = "Mise invalide (min 10 pts)";
			duelErrEl.hidden = false;
			return;
		}
		duelSendBtn.disabled = true;
		duelErrEl.hidden = true;
		try
		{
			await challengeDuel(duelTarget, stake);
			duelModal.hidden = true;
			toast(`⚔️ Défi envoyé à @${duelTarget} !`);
			void refreshDuels();
		}
		catch (e: any)
		{
			duelErrEl.textContent = e.message ?? "Erreur";
			duelErrEl.hidden = false;
		}
		finally { duelSendBtn.disabled = false; }
	});

	onDuel(() => void refreshDuels());

	// Tabs
	document.querySelectorAll<HTMLButtonElement>(".tab").forEach((tab) =>
	{
		tab.addEventListener("click", () =>
		{
			const t = tab.dataset.tab;
			document
				.querySelectorAll(".tab")
				.forEach((x) => x.classList.toggle("is-active", x === tab));
			document
				.querySelectorAll<HTMLElement>("[data-pane]")
				.forEach((p) => (p.hidden = p.dataset.pane !== t));
		});
	});

	// Live
	onFriendEvent(() =>
	{
		refresh();
		rerunSearch();
	});
	onPresence(() => refresh());
	loadPresence();
	refresh();
</script>

<style>
  .wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 48px) clamp(16px, 4vw, 40px);
  }
  .head h1 {
    margin: 0;
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .head p {
    margin: 8px 0 24px;
    color: var(--muted);
  }
  .search {
    position: relative;
    margin-bottom: 24px;
  }
  .results {
    margin-top: 8px;
  }
  .tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
  }
  .tab {
    background: var(--panel);
    border: 1px solid var(--line);
    color: var(--muted);
    border-radius: 8px;
    padding: 10px 14px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .tab.is-active {
    color: var(--fg);
    border-color: var(--accent);
  }
  .count {
    background: var(--raise);
    border-radius: 6px;
    padding: 1px 6px;
    font-size: 11px;
    margin-left: 4px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  /* rows are injected at runtime -> target them globally under .list */
  .list :global(.empty) {
    color: var(--muted);
    text-align: center;
    padding: 36px 0;
  }
  .list :global(.empty.sm) {
    padding: 16px 0;
  }
  .list :global(.subhead) {
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 8px 4px 2px;
  }
  .list :global(.empty a) {
    color: var(--accent);
  }
  .list :global(.row) {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
  }
  .list :global(.avwrap) {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
  }
  .list :global(.av) {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--raise);
  }
  .list :global(.av.fb) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: #fff;
    background: var(--accent);
  }
  .list :global(.pres) {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 2px solid var(--panel);
  }
  .list :global(.pres.on) {
    background: var(--win);
  }
  .list :global(.pres.off) {
    background: var(--muted);
  }
  .list :global(.name) {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    font-weight: 600;
    flex: 1;
    min-width: 0;
  }
  .list :global(.name small) {
    color: var(--muted);
    font-weight: 400;
    font-size: 12px;
  }
  .list :global(.pts) {
    color: var(--muted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .list :global(.tag) {
    font-size: 12px;
    color: var(--muted);
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .list :global(.tag.ok) {
    color: var(--win);
    border-color: var(--win);
  }
  .list :global(.ghost-btn.sm),
  .list :global(.btn.sm) {
    padding: 8px 12px;
    font-size: 12px;
  }
  .list :global(.gift-btn) {
    padding: 8px 10px;
    font-size: 16px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.1s, border-color 0.1s;
    font-family: inherit;
  }
  .list :global(.gift-btn:hover) {
    background: rgba(34,197,94,0.1);
    border-color: #22c55e;
  }

  /* Gift modal */
  [hidden] { display: none !important; }

  .gift-modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 16px;
    backdrop-filter: blur(4px);
  }

  .gift-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px 24px 24px;
    max-width: 340px;
    width: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .gift-close {
    position: absolute;
    top: 12px; right: 14px;
    background: none; border: none;
    color: var(--muted); font-size: 16px;
    cursor: pointer; padding: 4px 8px;
    border-radius: 6px; transition: color 0.1s, background 0.1s;
    font-family: inherit;
  }
  .gift-close:hover { color: var(--fg); background: var(--raise); }

  .gift-icon { font-size: 36px; }
  .gift-title { margin: 0; font-size: 20px; font-weight: 800; }
  .gift-to { margin: 0; color: var(--muted); font-size: 13px; }
  .gift-err {
    color: #ef4444;
    font-size: 13px;
    margin: 0;
  }

  @media (max-width: 560px) {
    .list :global(.row) {
      flex-wrap: wrap;
    }
    .list :global(.pts) {
      display: none;
    }
  }
</style>
