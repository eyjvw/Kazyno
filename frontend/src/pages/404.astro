---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Kazyno — 404">
  <div class="page">
    <header class="topbar">
      <a class="brand" href="/">Kazyno</a>
    </header>

    <section class="hero">
      <span class="big accent">404</span>
      <h1 class="title">Carte introuvable</h1>
      <p class="lede">
        Cette page n'existe pas — la maison a déjà ramassé les jetons.
      </p>
      <div class="cta">
        <a class="btn" href="/app">Retour au casino</a>
        <a class="btn ghost" href="/">Accueil</a>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<style>
  .page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  .page::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(55% 50% at 50% 0%, rgba(59, 130, 246, 0.18), transparent 60%);
    pointer-events: none;
  }
  .topbar {
    position: relative;
    padding: 22px clamp(20px, 5vw, 56px);
    border-bottom: 1px solid var(--line);
  }
  .brand {
    font-weight: 800;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .accent {
    color: var(--accent);
  }
  .hero {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 40px clamp(20px, 5vw, 56px);
  }
  .big {
    font-size: clamp(90px, 20vw, 220px);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.04em;
  }
  .title {
    margin: 8px 0 0;
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .lede {
    max-width: 460px;
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 16px;
  }
  .cta {
    display: flex;
    gap: 12px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 15px;
    padding: 14px 22px;
    border-radius: 10px;
    transition: filter 0.15s, transform 0.08s;
  }
  .btn:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
  }
  .btn.ghost {
    background: var(--panel);
    border: 1px solid var(--line);
    color: var(--fg);
  }
  .btn.ghost:hover {
    border-color: var(--accent);
  }
</style>
