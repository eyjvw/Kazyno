---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Kazyno — Boutique">
  <Nav />
  <main class="shop">
    <header class="head">
      <h1>Boutique 🛍️</h1>
      <p>Dépense tes points : titres et couleurs de pseudo.</p>
    </header>

    <section class="shop-sec">
      <h2 class="section-title">Titres</h2>
      <div class="shop-grid" data-titles></div>
    </section>

    <section class="shop-sec">
      <h2 class="section-title">Couleurs de pseudo</h2>
      <div class="shop-grid" data-colors></div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
	import { getShop, buyItem, equipItem, fmt, toast, getBalance, loadMe } from "../lib/casino";

	const GRADS = ["rainbow", "fire", "ocean", "galaxy", "toxic"];
	let myLogin = "pseudo";
	const escapeHtml = (s: string) =>
		s.replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
	const titlesEl = document.querySelector<HTMLElement>("[data-titles]")!;
	const colorsEl = document.querySelector<HTMLElement>("[data-colors]")!;

	interface Item
	{
		key: string;
		kind: "title" | "color";
		label: string;
		value: string;
		price: number;
		exclusive?: boolean;
	}

	let owned: string[] = [];
	let equipped: { title: string | null; name_color: string | null } = { title: null, name_color: null };
	let items: Item[] = [];

	function render()
	{
		titlesEl.innerHTML = "";
		colorsEl.innerHTML = "";
		const buyable = items.filter((i) => !i.exclusive);
		const ownedBuyable = buyable.filter((i) => owned.includes(i.key)).length;
		for (const item of items)
		{
			const has = owned.includes(item.key);
			const isEquipped = item.kind === "title"
				? equipped.title === item.value
				: equipped.name_color === item.value;
			const lockedExclusive = !!item.exclusive && !has;
			const card = document.createElement("div");
			card.className = "shop-card"
				+ (isEquipped ? " equipped" : "")
				+ (item.exclusive ? " exclusive" : "")
				+ (lockedExclusive ? " locked" : "");
			card.innerHTML = `
				<div class="shop-preview">${
					item.kind === "title"
						? `<span class="title-badge">${lockedExclusive ? "???" : item.value}</span>`
						: GRADS.includes(item.value)
							? `<span class="color-preview grad-${item.value}">${escapeHtml(myLogin)}</span>`
							: `<span class="color-preview" style="color:${item.value}">${escapeHtml(myLogin)}</span>`
				}</div>
				<b class="shop-label">${item.label}</b>
				<span class="shop-price">${
					has ? (isEquipped ? "Équipé ✓" : "Possédé")
					: item.exclusive ? `👑 Collection complète — ${ownedBuyable}/${buyable.length}`
					: `${fmt(item.price)} pts`
				}</span>
				${lockedExclusive
					? `<button class="btn shop-btn shop-locked" disabled>🔒 Possède toute la boutique</button>`
					: `<button class="btn shop-btn" data-key="${item.key}">
							${isEquipped ? "Retirer" : has ? "Équiper" : "Acheter"}
						</button>`}`;
			if (lockedExclusive)
			{
				(item.kind === "title" ? titlesEl : colorsEl).appendChild(card);
				continue;
			}
			const btn = card.querySelector<HTMLButtonElement>(".shop-btn")!;
			btn.addEventListener("click", async () =>
			{
				btn.disabled = true;
				try
				{
					if (isEquipped)
					{
						await equipItem(null, item.kind);
						if (item.kind === "title") equipped.title = null;
						else equipped.name_color = null;
					}
					else if (has)
					{
						await equipItem(item.key);
						if (item.kind === "title") equipped.title = item.value;
						else equipped.name_color = item.value;
					}
					else
					{
						if (getBalance() < item.price) throw new Error("Solde insuffisant");
						await buyItem(item.key);
						owned.push(item.key);
						toast(`🛍️ ${item.label} acheté !`);
					}
					render();
				}
				catch (e: any)
				{
					toast(e?.message ?? "Erreur");
					btn.disabled = false;
				}
			});
			(item.kind === "title" ? titlesEl : colorsEl).appendChild(card);
		}
	}

	loadMe().then((me) => { if (me?.login) myLogin = me.login; render(); });

	getShop().then((d) =>
	{
		items = d.items ?? [];
		owned = d.owned ?? [];
		equipped = d.equipped ?? { title: null, name_color: null };
		render();
	});
</script>

<style>
  .shop {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 48px) clamp(16px, 4vw, 40px);
  }
  .head h1 {
    margin: 0;
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .head p {
    margin: 8px 0 26px;
    color: var(--muted);
  }
  .shop-sec { margin-bottom: 32px; }
  .section-title {
    margin: 0 0 16px;
    font-size: 20px;
    font-weight: 800;
  }
  .shop-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
  .shop-grid :global(.shop-card) {
    flex: 1 1 210px;
    max-width: 250px;
  }
  :global(.shop-card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px 16px;
    text-align: center;
    transition: border-color 0.15s, transform 0.15s;
  }
  :global(.shop-card:hover) { transform: translateY(-2px); }
  :global(.shop-card.equipped) {
    border-color: #22c55e;
    background: rgba(34, 197, 94, 0.05);
  }
  :global(.shop-preview) {
    min-height: 34px;
    display: flex;
    align-items: center;
  }
  :global(.title-badge) {
    background: rgba(245, 158, 11, 0.14);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 13px;
    font-weight: 800;
  }
  :global(.color-preview) { font-size: 17px; font-weight: 800; }
  :global(.shop-label) { font-size: 13px; }
  :global(.shop-price) {
    color: var(--muted);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  :global(.shop-btn) { width: 100%; font-size: 13px; padding: 9px; }

  /* Item exclusif (récompense de collection) */
  :global(.shop-card.exclusive) {
    border-color: rgba(212, 175, 55, 0.5);
    background: linear-gradient(160deg, rgba(212, 175, 55, 0.07), var(--panel) 55%);
  }
  :global(.shop-card.exclusive .shop-price) { color: var(--accent); font-weight: 700; }
  :global(.shop-card.locked .title-badge) { filter: grayscale(1); opacity: 0.6; }
  /* Variante de fond → couleur redéfinie obligatoire (jamais accent-ink sur fond sombre) */
  :global(.shop-locked) {
    background: var(--raise);
    color: var(--muted);
    cursor: default;
    box-shadow: none;
  }
  :global(.shop-locked:hover) { background: var(--raise); box-shadow: none; }
</style>
