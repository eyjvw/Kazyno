---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import GameShell from "../components/GameShell.astro";
import Button from "../components/Button.astro";
import Input from "../components/Input.astro";
---

<Layout title="Kazyno — Crash">
  <Nav />
  <main class="app-main">
    <GameShell title="Crash" subtitle="Cashout avant le crash" emoji="📈">
      <div slot="betpanel" class="betpanel">
        <div class="field">
          <label>Mise</label>
          <Input type="number" placeholder="100" data-bet-input />
        </div>

        <Button variant="primary" class="bet-btn" data-play-btn>Jouer</Button>
        <Button variant="ghost" class="bet-btn" data-cashout-btn disabled>Encaisser</Button>

        <div class="sess-stats">
          <div class="ss">
            <span>Mise</span>
            <b data-bet-display>—</b>
          </div>
          <div class="ss">
            <span>Multiplicateur</span>
            <b data-mult-display>0.00×</b>
          </div>
        </div>
      </div>

      <div slot="stage" class="stage-crash">
        <svg class="crash-graph" data-crash-svg viewBox="0 0 400 200" width="400" height="200">
          <polyline class="crash-line" points="0,190 400,190" data-crash-line />
        </svg>
        <p class="result" data-result hidden></p>
      </div>
    </GameShell>
  </main>

  <Footer />
</Layout>

<script>
  import { playCrash, fmt } from "../lib/casino";

  const betInput = document.querySelector<HTMLInputElement>("[data-bet-input]")!;
  const playBtn = document.querySelector<HTMLButtonElement>("[data-play-btn]")!;
  const cashoutBtn = document.querySelector<HTMLButtonElement>("[data-cashout-btn]")!;
  const resultEl = document.querySelector<HTMLElement>("[data-result]")!;
  const multDisplay = document.querySelector<HTMLElement>("[data-mult-display]")!;
  const betDisplay = document.querySelector<HTMLElement>("[data-bet-display]")!;
  const crashLine = document.querySelector<SVGPolylineElement>("[data-crash-line]")!;

  playBtn.addEventListener("click", async () => {
    const bet = parseInt(betInput.value);
    if (!bet) return;

    playBtn.disabled = true;
    cashoutBtn.disabled = false;
    betDisplay.textContent = fmt(bet);
    resultEl.hidden = true;

    try {
      const result = await playCrash(bet);
      animateCrashLine(result.crash_at, 3000);

      let mult = 1;
      const interval = setInterval(() => {
        mult += 0.1;
        if (mult >= result.crash_at) {
          mult = result.crash_at;
          clearInterval(interval);
          setTimeout(() => {
            resultEl.textContent = `Crash à ${(result.crash_at).toFixed(2)}×!`;
            resultEl.className = "result lose";
            resultEl.hidden = false;
            playBtn.disabled = false;
            cashoutBtn.disabled = true;
          }, 300);
        }
        multDisplay.textContent = `${mult.toFixed(2)}×`;
      }, 50);

      cashoutBtn.addEventListener(
        "click",
        async () => {
          clearInterval(interval);
          const payout = bet * mult;
          resultEl.textContent = `Encaissé ${fmt(payout)} pts à ${mult.toFixed(2)}×!`;
          resultEl.className = "result win";
          resultEl.hidden = false;
          cashoutBtn.disabled = true;
          playBtn.disabled = false;
        },
        { once: true }
      );
    } catch (e: any) {
      resultEl.textContent = e?.message ?? "Erreur";
      resultEl.className = "result lose";
      resultEl.hidden = false;
      playBtn.disabled = false;
      cashoutBtn.disabled = true;
    }
  });

  function animateCrashLine(crashAt: number, duration: number) {
    const points = [];
    const steps = 40;
    for (let i = 0; i <= steps; i++) {
      const x = (i / steps) * 400;
      const t = i / steps;
      const y = 190 - (Math.exp(t * Math.log(crashAt)) - 1) * 100;
      points.push(`${x},${Math.max(y, 10)}`);
    }
    crashLine.setAttribute("points", points.join(" "));
  }
</script>

<style>
  .app-main {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .betpanel {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field label {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 700;
  }

  .bet-btn {
    width: 100%;
    padding: 14px;
    font-size: 15px;
  }

  .sess-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .ss {
    background: var(--surface-2);
    border-radius: 7px;
    padding: 7px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ss span {
    color: var(--text-muted);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .ss b {
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .stage-crash {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .crash-graph {
    filter: drop-shadow(0 0 12px rgba(212, 175, 55, 0.2));
    stroke: var(--primary);
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .crash-line {
    animation: drawLine 3s ease-in forwards;
  }

  @keyframes drawLine {
    from {
      stroke-dasharray: 1000;
      stroke-dashoffset: 1000;
    }
    to {
      stroke-dasharray: 1000;
      stroke-dashoffset: 0;
    }
  }

  .result {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    animation: popIn var(--duration-medium) var(--easing-smooth);
  }

  .result.win {
    color: var(--success);
  }

  .result.lose {
    color: var(--danger);
  }
</style>
