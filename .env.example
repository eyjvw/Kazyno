# Copy to .env and fill values: cp .env.example .env

# Postgres
POSTGRES_PASSWORD=piscasino

# Session signing secret (JWT). Generate: openssl rand -hex 32
SESSION_SECRET=change-me-with-openssl-rand-hex-32

# 42 OAuth app credentials (https://profile.intra.42.fr/oauth/applications)
# Redirect URI of the app MUST equal FT_REDIRECT_URI below.
FT_UID=
FT_SECRET=
FT_REDIRECT_URI=http://localhost:8080/api/auth/callback

# Public origin users hit (the gateway)
FRONTEND_ORIGIN=http://localhost:8080

# Comma-separated logins with admin panel access
ADMIN_LOGINS=
